{
  "domain": "reminder",
  "description": "Reminder creation and management",
  "response_frames": {
    "create_with_date": [
      "I'll remind you about $content on $date.",
      "Reminder set for $date: $content.",
      "Got it - I'll remind you about $content on $date."
    ],
    "create_content_only": [
      "When would you like to be reminded about $content?",
      "What date or time should I set the reminder for $content?"
    ],
    "missing_content": [
      "What would you like me to remind you about?",
      "What should the reminder say?",
      "What do you want to be reminded of?"
    ]
  },
  "enriched_response_frames": {
    "set_with_text_date_and_time": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_text", "reminder_date", "reminder_time"],
      "templates": [
        "Reminder set for $reminder_date at $reminder_time: $reminder_text.",
        "Your reminder for $reminder_date at $reminder_time is set: $reminder_text."
      ]
    },
    "set_with_text_and_time": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_text", "reminder_time"],
      "templates": [
        "Reminder set for $reminder_time: $reminder_text.",
        "Your reminder for $reminder_time is set: $reminder_text."
      ]
    },
    "set_with_text_and_date": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_text", "reminder_date"],
      "templates": [
        "Reminder set for $reminder_date: $reminder_text.",
        "Your reminder for $reminder_date is set: $reminder_text."
      ]
    },
    "set_with_text": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_text"],
      "templates": [
        "Reminder set: $reminder_text.",
        "Your reminder is set: $reminder_text."
      ]
    },
    "set_with_date_and_time": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_date", "reminder_time"],
      "templates": [
        "Reminder set for $reminder_date at $reminder_time.",
        "Your reminder for $reminder_date at $reminder_time is set."
      ]
    },
    "set_with_time": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_time"],
      "templates": [
        "Reminder set for $reminder_time.",
        "Your reminder for $reminder_time is set."
      ]
    },
    "set_with_date": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": ["reminder_date"],
      "templates": [
        "Reminder set for $reminder_date.",
        "Your reminder for $reminder_date is set."
      ]
    },
    "set": {
      "when": {"reminder_set": true, "reminder_count": null},
      "requires_enrichment": [],
      "templates": [
        "Reminder set.",
        "Your reminder is set."
      ]
    },
    "none_found": {
      "when": {"reminder_count": 0},
      "requires_enrichment": [],
      "templates": [
        "You have no reminders.",
        "There are no reminders set."
      ]
    },
    "found_one_with_text": {
      "when": {"reminder_count": 1},
      "requires_enrichment": ["reminder_texts"],
      "templates": [
        "You have one reminder: $reminder_texts.",
        "There's one reminder set: $reminder_texts."
      ]
    },
    "found_one": {
      "when": {"reminder_count": 1},
      "requires_enrichment": [],
      "templates": [
        "You have one reminder.",
        "There's one reminder set."
      ]
    },
    "found_several_with_texts": {
      "when": {"reminder_count": {"min": 2}},
      "requires_enrichment": ["reminder_count", "reminder_texts"],
      "templates": [
        "You have $reminder_count reminders: $reminder_texts.",
        "There are $reminder_count reminders set: $reminder_texts."
      ]
    },
    "found_several": {
      "when": {"reminder_count": {"min": 2}},
      "requires_enrichment": ["reminder_count"],
      "templates": [
        "You have $reminder_count reminders.",
        "There are $reminder_count reminders set."
      ]
    },
    "cancelled_one_with_text": {
      "when": {"cancelled_count": 1, "reminder_set": false, "reminder_count": null},
      "requires_enrichment": ["reminder_texts"],
      "templates": [
        "Cancelled your reminder: $reminder_texts.",
        "Your reminder is cancelled: $reminder_texts."
      ]
    },
    "cancelled_one": {
      "when": {"cancelled_count": 1, "reminder_set": false, "reminder_count": null},
      "requires_enrichment": [],
      "templates": [
        "Cancelled your reminder.",
        "Your reminder is cancelled."
      ]
    },
    "cancelled_several_with_texts": {
      "when": {"cancelled_count": {"min": 2}, "reminder_set": false, "reminder_count": null},
      "requires_enrichment": ["cancelled_count", "reminder_texts"],
      "templates": [
        "Cancelled $cancelled_count reminders: $reminder_texts.",
        "Your $cancelled_count reminders are cancelled: $reminder_texts."
      ]
    },
    "cancelled_several": {
      "when": {"cancelled_count": {"min": 2}, "reminder_set": false, "reminder_count": null},
      "requires_enrichment": ["cancelled_count"],
      "templates": [
        "Cancelled $cancelled_count reminders.",
        "Your $cancelled_count reminders are cancelled."
      ]
    }
  },
  "entity_verbalizations": {
    "content": ["about $value", "$value"],
    "date": ["on $value", "at $value", "for $value"],
    "time": ["at $value"]
  },
  "acknowledgment_prefixes": [
    "Sure,",
    "Got it,",
    "No problem,"
  ],
  "slot_requirements": {
    "required": ["content"],
    "optional": ["date", "time"]
  },
  "enrichment_service": "scheduling",
  "enrichment_fields": {
    "reminder_set": {"description": "A boolean: true for a reminder created, or when a check finds reminders; false when a check finds none, and after a cancel", "source": "scheduling"},
    "reminder_text": {"description": "The text of the reminder created, as given; \"\" when none was given", "source": "scheduling"},
    "reminder_time": {"description": "The time of the reminder created, as given; \"\" when none was given", "source": "scheduling"},
    "reminder_date": {"description": "The date of the reminder created, as given; \"\" when none was given", "source": "scheduling"},
    "reminder_texts": {"description": "The text of each reminder a check found or a cancel removed, oldest first", "source": "scheduling"},
    "reminder_times": {"description": "The time of each reminder a check found or a cancel removed, oldest first", "source": "scheduling"},
    "reminder_dates": {"description": "The date of each reminder a check found or a cancel removed, oldest first; null for a reminder stored without one", "source": "scheduling"},
    "reminder_count": {"description": "How many reminders a check found", "source": "scheduling"},
    "cancelled_count": {"description": "How many reminders a cancel removed", "source": "scheduling"}
  }
}
