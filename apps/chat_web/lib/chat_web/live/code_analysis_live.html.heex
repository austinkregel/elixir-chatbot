<.app_shell
  current_world_id={@current_world_id}
  available_worlds={@available_worlds}
  current_path={@current_path}
  system_ready={@system_ready}
  flash={@flash}
>
  <:page_header>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-space-lg">
      <div>
        <h1 class="text-title text-ink flex items-center gap-space-sm">
          <.icon name="hero-code-bracket" class="size-6 text-ink-muted" />
          Code Analysis
        </h1>
        <p class="text-body text-ink-muted">
          World: <span class="font-semibold text-ink">{@current_world_id}</span>
        </p>
      </div>
      <div class="flex items-center gap-space-sm">
        <.badge
          variant={if @code_status.ready, do: :success, else: :warning}
          size={:sm}
        >
          <%= if @code_status.ready do %>
            <.icon name="hero-check-circle" class="size-3" /> System Ready
          <% else %>
            <.icon name="hero-clock" class="size-3" /> Initializing
          <% end %>
        </.badge>
      </div>
    </div>
  </:page_header>

  <div class="p-space-lg sm:p-space-xl lg:p-space-2xl space-y-space-xl">
    <!-- Stats Overview -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-space-lg">
      <.card class="p-space-lg">
        <div class="text-title tabular-nums text-ink">
          {Map.get(@world_stats, :symbols, 0)}
        </div>
        <div class="text-caption text-ink-muted">Symbols (this world)</div>
      </.card>
      <.card class="p-space-lg">
        <div class="text-title tabular-nums text-ink">
          {Map.get(@world_stats, :relations, 0)}
        </div>
        <div class="text-caption text-ink-muted">Relations</div>
      </.card>
      <.card class="p-space-lg">
        <div class="text-title tabular-nums text-ink">
          {length(@analyzed_files)}
        </div>
        <div class="text-caption text-ink-muted">Files Analyzed</div>
      </.card>
      <.card class="p-space-lg">
        <div class="text-title tabular-nums text-ink">
          {length(@language_breakdown)}
        </div>
        <div class="text-caption text-ink-muted">Languages Used</div>
      </.card>
    </section>

    <!-- Tab Navigation -->
    <.tabs class="w-fit flex-wrap">
      <.tab active={@active_tab == :browse} phx-click="switch_tab" phx-value-tab="browse">
        <.icon name="hero-magnifying-glass" class="size-4 mr-space-xs" />
        Browse
      </.tab>
      <.tab active={@active_tab == :stats} phx-click="switch_tab" phx-value-tab="stats">
        <.icon name="hero-chart-pie" class="size-4 mr-space-xs" />
        Statistics
      </.tab>
      <.tab active={@active_tab == :files} phx-click="switch_tab" phx-value-tab="files">
        <.icon name="hero-folder" class="size-4 mr-space-xs" />
        Files
      </.tab>
      <.tab active={@active_tab == :metrics} phx-click="switch_tab" phx-value-tab="metrics">
        <.icon name="hero-chart-bar" class="size-4 mr-space-xs" />
        Metrics
      </.tab>
      <.tab active={@active_tab == :analyze} phx-click="switch_tab" phx-value-tab="analyze">
        <.icon name="hero-beaker" class="size-4 mr-space-xs" />
        Analyze
      </.tab>
    </.tabs>

    <!-- Browse Tab -->
    <%= if @active_tab == :browse do %>
      <div class="flex gap-space-xl">
        <!-- Main Content -->
        <.card class={if @selected_symbol, do: "overflow-hidden flex-1", else: "overflow-hidden w-full"}>
          <div class="p-space-lg border-b border-border bg-surface">
            <div class="flex flex-col md:flex-row gap-space-lg">
              <!-- Search -->
              <div class="flex-1">
                <form phx-change="search_symbols" phx-submit="search_symbols">
                  <div class="relative">
                    <.icon name="hero-magnifying-glass" class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-ink-muted" />
                    <input
                      type="text"
                      name="query"
                      value={@search_query}
                      placeholder="Search symbols..."
                      class="w-full h-control-md pl-10 pr-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body text-ink placeholder:text-ink-muted"
                      phx-debounce="300"
                    />
                  </div>
                </form>
              </div>

              <!-- Filters -->
              <div class="flex gap-space-sm">
                <form phx-change="filter_type">
                  <select name="type" class="h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink">
                    <option value="">All Types</option>
                    <%= for type <- entity_types() do %>
                      <option value={type} selected={@selected_type == type}>
                        {entity_type_label(type)}
                      </option>
                    <% end %>
                  </select>
                </form>

                <form phx-change="filter_language">
                  <select name="language" class="h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink">
                    <option value="">All Languages</option>
                    <%= for lang <- supported_languages() do %>
                      <option value={lang} selected={@selected_language == lang}>
                        {language_name(lang)}
                      </option>
                    <% end %>
                  </select>
                </form>

                <.icon_btn
                  id="clear-world-symbols"
                  type="button"
                  size={:sm}
                  title="Clear all symbols for this world"
                  phx-click="open_confirm"
                  phx-value-id="confirm-clear-world-symbols"
                >
                  <.icon name="hero-trash" class="size-4" />
                </.icon_btn>
              </div>
            </div>
            <.execute_confirm
              id="confirm-clear-world-symbols"
              open={@open_confirm == "confirm-clear-world-symbols"}
              reach={:local}
              removes
              verb="Clear symbols"
              target={"code symbols · world #{@world_id}"}
              consequence={"Deletes every symbol and relation world #{@world_id} holds in the code gazetteer's tables on this node. Nothing else keeps them, so they return only when the code is analyzed again."}
              on_confirm="clear_world_symbols"
              on_cancel="close_confirm"
              trigger_id="clear-world-symbols"
              error={@confirm_error}
              class="mt-space-md ml-auto"
            />
          </div>

          <div class="p-space-lg">
            <%= if length(@symbols) > 0 do %>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-body-dense text-ink">
                  <thead class="bg-surface-sunk">
                    <tr class="text-label text-ink-muted">
                      <th class="h-row-compact px-space-sm">Type</th>
                      <th class="h-row-compact px-space-sm">Name</th>
                      <th class="h-row-compact px-space-sm">Qualified Name</th>
                      <th class="h-row-compact px-space-sm">Language</th>
                      <th class="h-row-compact px-space-sm">Location</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    <%= for symbol <- @symbols do %>
                      <tr
                        class="even:bg-surface-sunk hover:bg-primary-wash cursor-pointer"
                        phx-click="select_symbol"
                        phx-value-name={symbol.qualified_name}
                      >
                        <td class="h-row-compact px-space-sm">
                          <.badge variant={:default} size={:xs}>
                            <.icon name={entity_type_icon(symbol.entity_type)} class="size-3" />
                            {entity_type_label(symbol.entity_type)}
                          </.badge>
                        </td>
                        <td class="h-row-compact px-space-sm text-value-strong">{symbol.name}</td>
                        <td class="h-row-compact px-space-sm text-ref text-ink-muted max-w-[200px] truncate" title={symbol.qualified_name}>{symbol.qualified_name}</td>
                        <td class="h-row-compact px-space-sm">
                          <.badge variant={:default} size={:xs}>
                            {language_name(symbol.language)}
                          </.badge>
                        </td>
                        <td class="h-row-compact px-space-sm text-caption text-ink-muted">
                          <%= if symbol.file_path do %>
                            <span class="text-ref" title={symbol.file_path}>
                              {Path.basename(symbol.file_path || "")}<%= if symbol.line do %>:{symbol.line}<% end %>
                            </span>
                          <% else %>
                            <span class="italic">-</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <div class="mt-space-lg text-caption text-ink-muted">
                Showing {length(@symbols)} symbols · Click a row for details
              </div>
            <% else %>
              <div class="text-center py-space-3xl">
                <div class="inline-flex items-center justify-center size-16 rounded-md bg-surface-sunk mb-space-lg">
                  <.icon name="hero-code-bracket" class="size-8 text-ink-muted" />
                </div>
                <p class="text-subheading text-ink-muted">No symbols found</p>
                <p class="text-caption text-ink-muted mt-space-xs">
                  <%= if @search_query != "" do %>
                    Try a different search query
                  <% else %>
                    Analyze some code to populate the symbol database
                  <% end %>
                </p>
              </div>
            <% end %>
          </div>
        </.card>

        <!-- Symbol Detail Panel -->
        <%= if @selected_symbol do %>
          <aside class="panel w-96 overflow-hidden h-fit">
            <div class="p-space-lg border-b border-border bg-surface-sunk">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-space-sm">
                  <div class="p-space-sm rounded-md bg-surface">
                    <.icon name={entity_type_icon(@selected_symbol.entity_type)} class="size-5 text-ink-muted" />
                  </div>
                  <div>
                    <h3 class="text-subheading text-ink">{@selected_symbol.name}</h3>
                    <.badge variant={:default} size={:xs}>{entity_type_label(@selected_symbol.entity_type)}</.badge>
                  </div>
                </div>
                <.icon_btn type="button" size={:sm} title="Close" phx-click="close_symbol_detail">
                  <.icon name="hero-x-mark" class="size-4" />
                </.icon_btn>
              </div>
            </div>

            <div class="p-space-lg space-y-space-lg">
              <!-- Details -->
              <div class="space-y-space-sm text-body">
                <div class="flex justify-between">
                  <span class="text-ink-muted">Qualified Name</span>
                  <span class="text-ref text-ink">{@selected_symbol.qualified_name}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ink-muted">Language</span>
                  <.badge variant={:default} size={:xs}>{language_name(@selected_symbol.language)}</.badge>
                </div>
                <%= if @selected_symbol.file_path do %>
                  <div class="flex justify-between">
                    <span class="text-ink-muted">File</span>
                    <button
                      class="text-ref text-accent hover:underline text-right max-w-[180px] truncate"
                      phx-click="view_file_symbols"
                      phx-value-path={@selected_symbol.file_path}
                      title={@selected_symbol.file_path}
                    >
                      {Path.basename(@selected_symbol.file_path)}
                    </button>
                  </div>
                <% end %>
                <%= if @selected_symbol.line do %>
                  <div class="flex justify-between">
                    <span class="text-ink-muted">Line</span>
                    <span class="text-value text-ink">{@selected_symbol.line}</span>
                  </div>
                <% end %>
              </div>

              <!-- Metadata -->
              <%= if @selected_symbol.metadata && map_size(@selected_symbol.metadata) > 0 do %>
                <div>
                  <h4 class="text-label text-ink-muted mb-space-sm">Metadata</h4>
                  <div class="space-y-space-xs">
                    <%= for {key, value} <- @selected_symbol.metadata do %>
                      <div class="flex justify-between text-body">
                        <span class="text-ink-muted">{key}</span>
                        <span class="text-term text-ink">{inspect(value)}</span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- Relations -->
              <%= if length(@symbol_relations) > 0 do %>
                <div>
                  <h4 class="text-label text-ink-muted mb-space-sm">Relationships</h4>
                  <div class="space-y-space-xs">
                    <%= for rel <- @symbol_relations do %>
                      <div class="flex items-center gap-space-sm p-space-sm rounded-md bg-surface-sunk text-caption">
                        <.icon name={relation_icon(rel.type)} class="size-3 text-ink-muted" />
                        <span class="text-ink-muted">{relation_label(rel.type)}</span>
                        <span class="text-ref text-ink flex-1 truncate" title={rel.target}>{rel.target}</span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </aside>
        <% end %>
      </div>
    <% end %>

    <!-- Statistics Tab -->
    <%= if @active_tab == :stats do %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-xl">
        <!-- Type Breakdown -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-cube" class="size-5 text-ink-muted" />
              <h2 class="text-heading text-ink">Symbols by Type</h2>
            </div>
          </div>
          <div class="p-space-lg">
            <%= if length(@type_breakdown) > 0 do %>
              <div class="space-y-space-md">
                <%= for {type, count} <- @type_breakdown do %>
                  <div class="flex items-center gap-space-md">
                    <div class="p-space-xs rounded-md bg-surface-sunk">
                      <.icon name={entity_type_icon(type)} class="size-4 text-ink-muted" />
                    </div>
                    <div class="flex-1">
                      <div class="flex justify-between items-center mb-space-xs">
                        <.badge variant={:default} size={:xs}>{entity_type_label(type)}</.badge>
                        <span class="text-value text-ink-muted">{count}</span>
                      </div>
                      <div class="h-space-sm bg-score-track rounded-sm overflow-hidden">
                        <div
                          class="h-full rounded-sm bg-score-count"
                          style={"width: #{min(count / max(elem(hd(@type_breakdown), 1), 1) * 100, 100)}%"}
                        ></div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-center text-body text-ink-muted py-space-2xl">No symbols analyzed yet</p>
            <% end %>
          </div>
        </.card>

        <!-- Language Breakdown -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-language" class="size-5 text-ink-muted" />
              <h2 class="text-heading text-ink">Symbols by Language</h2>
            </div>
          </div>
          <div class="p-space-lg">
            <%= if length(@language_breakdown) > 0 do %>
              <div class="space-y-space-md">
                <%= for {lang, count} <- @language_breakdown do %>
                  <div class="flex items-center gap-space-md">
                    <.badge variant={:default} size={:sm}>{language_name(lang)}</.badge>
                    <div class="flex-1">
                      <div class="flex justify-between items-center mb-space-xs">
                        <div></div>
                        <span class="text-value text-ink-muted">{count}</span>
                      </div>
                      <div class="h-space-sm bg-score-track rounded-sm overflow-hidden">
                        <div
                          class="h-full rounded-sm bg-score-count"
                          style={"width: #{min(count / max(elem(hd(@language_breakdown), 1), 1) * 100, 100)}%"}
                        ></div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-center text-body text-ink-muted py-space-2xl">No symbols analyzed yet</p>
            <% end %>
          </div>
        </.card>

        <!-- Supported Languages -->
        <.card class="overflow-hidden lg:col-span-2">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-check-circle" class="size-5 text-ink" />
              <h2 class="text-heading text-ink">Supported Languages</h2>
            </div>
          </div>
          <div class="p-space-lg">
            <div class="flex flex-wrap gap-space-sm">
              <%= for lang <- @code_status.language_grammar.stats.languages do %>
                <div class="flex items-center gap-space-sm px-space-md py-space-sm rounded-md bg-surface-sunk border border-border">
                  <.icon name="hero-check-circle" class="size-4 text-ink" />
                  <span class="text-subheading text-ink">{language_name(lang)}</span>
                </div>
              <% end %>
            </div>
          </div>
        </.card>
      </div>
    <% end %>

    <!-- Files Tab -->
    <%= if @active_tab == :files do %>
      <.card class="overflow-hidden">
        <div class="p-space-lg border-b border-border bg-surface-sunk">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-folder" class="size-5 text-ink-muted" />
              <h2 class="text-heading text-ink">Analyzed Files</h2>
            </div>
            <.badge variant={:default} size={:sm}>{length(@analyzed_files)} files</.badge>
          </div>
        </div>
        <div class="p-space-lg">
          <%= if length(@analyzed_files) > 0 do %>
            <div class="max-h-96 overflow-y-auto space-y-space-xs">
              <%= for file <- @analyzed_files do %>
                <button
                  type="button"
                  class="w-full flex items-center gap-space-sm p-space-sm rounded-md hover:bg-surface-sunk text-left transition-colors"
                  phx-click="view_file_symbols"
                  phx-value-path={file}
                >
                  <.icon name="hero-document-text" class="size-4 text-ink-muted" />
                  <span class="text-ref text-ink truncate flex-1" title={file}>{file}</span>
                  <.icon name="hero-chevron-right" class="size-4 text-ink-muted" />
                </button>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-space-3xl">
              <div class="inline-flex items-center justify-center size-16 rounded-md bg-surface-sunk mb-space-lg">
                <.icon name="hero-folder" class="size-8 text-ink-muted" />
              </div>
              <p class="text-subheading text-ink-muted">No files analyzed</p>
              <p class="text-caption text-ink-muted mt-space-xs">
                Ingest a codebase to see analyzed files
              </p>
            </div>
          <% end %>
        </div>
      </.card>
    <% end %>

    <!-- Metrics Tab -->
    <%= if @active_tab == :metrics do %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-lg">
        <!-- Pipeline Metrics -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-cpu-chip" class="size-5 text-ink-muted" />
              <h2 class="text-subheading text-ink">Pipeline</h2>
            </div>
          </div>
          <div class="p-space-lg space-y-space-md">
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Avg Time</span>
              <span class="text-value-strong text-ink">{format_metric_value(@code_metrics.pipeline)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Total Calls</span>
              <span class="text-value text-ink">{format_metric_count(@code_metrics.pipeline)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Rate</span>
              <span class="text-value text-ink">{format_metric_rate(@code_metrics.pipeline)}</span>
            </div>
          </div>
        </.card>

        <!-- Parse Metrics -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-document-text" class="size-5 text-ink-muted" />
              <h2 class="text-subheading text-ink">Parsing</h2>
            </div>
          </div>
          <div class="p-space-lg space-y-space-md">
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Avg Time</span>
              <span class="text-value-strong text-ink">{format_metric_value(@code_metrics.parse)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Total Calls</span>
              <span class="text-value text-ink">{format_metric_count(@code_metrics.parse)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Rate</span>
              <span class="text-value text-ink">{format_metric_rate(@code_metrics.parse)}</span>
            </div>
          </div>
        </.card>

        <!-- Extract Metrics -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-scissors" class="size-5 text-ink-muted" />
              <h2 class="text-subheading text-ink">Extraction</h2>
            </div>
          </div>
          <div class="p-space-lg space-y-space-md">
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Avg Time</span>
              <span class="text-value-strong text-ink">{format_metric_value(@code_metrics.extract)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Total Calls</span>
              <span class="text-value text-ink">{format_metric_count(@code_metrics.extract)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Rate</span>
              <span class="text-value text-ink">{format_metric_rate(@code_metrics.extract)}</span>
            </div>
          </div>
        </.card>

        <!-- Lookup Metrics -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-magnifying-glass" class="size-5 text-ink-muted" />
              <h2 class="text-subheading text-ink">Lookups</h2>
            </div>
          </div>
          <div class="p-space-lg space-y-space-md">
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Avg Time</span>
              <span class="text-value-strong text-ink">{format_metric_value(@code_metrics.gazetteer_lookup)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Total Calls</span>
              <span class="text-value text-ink">{format_metric_count(@code_metrics.gazetteer_lookup)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-caption text-ink-muted">Rate</span>
              <span class="text-value text-ink">{format_metric_rate(@code_metrics.gazetteer_lookup)}</span>
            </div>
          </div>
        </.card>
      </div>

      <!-- Usage Hint -->
      <div class="p-space-lg rounded-md bg-surface-sunk border border-border">
        <p class="text-body text-ink-muted">
          <.icon name="hero-information-circle" class="size-4 inline mr-space-xs" />
          Metrics update automatically every 5 seconds. To analyze a codebase, use:
        </p>
        <code class="block mt-space-sm px-space-md py-space-sm bg-surface rounded-sm text-term text-ink">
          World.DocumentIngestor.ingest_codebase("{@current_world_id}", "/path/to/project")
        </code>
      </div>
    <% end %>

    <!-- Analyze Tab -->
    <%= if @active_tab == :analyze do %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-xl">
        <!-- Code Input -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-space-sm">
                <.icon name="hero-document-text" class="size-5 text-ink-muted" />
                <h2 class="text-heading text-ink">Code Input</h2>
              </div>
              <form phx-change="select_input_language">
                <select name="language" class="h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink">
                  <%= for lang <- supported_languages() do %>
                    <option value={lang} selected={@selected_input_language == lang}>
                      {language_name(lang)}
                    </option>
                  <% end %>
                </select>
              </form>
            </div>
          </div>

          <div class="p-space-lg space-y-space-lg">
            <form phx-change="update_code_input">
              <textarea
                name="code"
                rows="15"
                class="w-full px-space-sm py-space-xs rounded-sm border border-border-strong bg-surface-sunk text-term text-ink placeholder:text-ink-muted"
                placeholder={"Enter #{language_name(@selected_input_language)} code to analyze..."}
                phx-debounce="300"
              >{@code_input}</textarea>
            </form>

            <div class="flex gap-space-sm">
              <.btn
                type="button"
                class="flex-1"
                phx-click="analyze_code"
                disabled={@analyzing or String.trim(@code_input) == ""}
              >
                <%= if @analyzing do %>
                  <.icon name="hero-arrow-path" class="size-4 animate-spin text-progress-fill" />
                  Analyzing...
                <% else %>
                  <.icon name="hero-play" class="size-4" />
                  Analyze
                <% end %>
              </.btn>
              <.btn
                type="button"
                variant={:ghost}
                phx-click="clear_analysis"
                disabled={@analyzing}
              >
                Clear
              </.btn>
            </div>
          </div>
        </.card>

        <!-- Analysis Results -->
        <.card class="overflow-hidden">
          <div class="p-space-lg border-b border-border bg-surface-sunk">
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-chart-bar" class="size-5 text-ink-muted" />
              <h2 class="text-heading text-ink">Analysis Results</h2>
            </div>
          </div>

          <div class="p-space-lg">
            <%= if @analysis_result do %>
              <%= if @analysis_result.success do %>
                <div class="space-y-space-lg">
                  <%= if @analysis_result.summary && @analysis_result.summary != "" do %>
                    <div class="rounded-md bg-surface-sunk p-space-md">
                      <h3 class="text-subheading text-ink mb-space-xs">Summary</h3>
                      <p class="text-body text-ink">{@analysis_result.summary}</p>
                    </div>
                  <% end %>

                  <div class="grid grid-cols-3 gap-space-md">
                    <div class="rounded-md bg-surface-sunk border border-border p-space-md text-center">
                      <div class="text-heading tabular-nums text-ink">{length(@analysis_result.symbols)}</div>
                      <div class="text-caption text-ink-muted">Symbols</div>
                    </div>
                    <div class="rounded-md bg-surface-sunk border border-border p-space-md text-center">
                      <div class="text-heading tabular-nums text-ink">{length(@analysis_result.relations)}</div>
                      <div class="text-caption text-ink-muted">Relations</div>
                    </div>
                    <div class="rounded-md bg-surface-sunk border border-border p-space-md text-center">
                      <div class="text-heading tabular-nums text-ink">{length(@analysis_result.errors)}</div>
                      <div class="text-caption text-ink-muted">Warnings</div>
                    </div>
                  </div>

                  <%= if length(@analysis_result.symbols) > 0 do %>
                    <div>
                      <h3 class="text-subheading text-ink mb-space-sm">Extracted Symbols</h3>
                      <div class="max-h-64 overflow-y-auto space-y-space-xs">
                        <%= for symbol <- @analysis_result.symbols do %>
                          <div class="flex items-center gap-space-sm p-space-sm rounded-md bg-surface-sunk">
                            <.icon name={entity_type_icon(symbol.entity_type)} class="size-4 text-ink-muted" />
                            <span class="text-value text-ink">{symbol.name}</span>
                            <.badge variant={:default} size={:xs} class="border border-border">
                              {entity_type_label(symbol.entity_type)}
                            </.badge>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <%= if length(@analysis_result.relations) > 0 do %>
                    <div>
                      <h3 class="text-subheading text-ink mb-space-sm">Relationships</h3>
                      <div class="max-h-48 overflow-y-auto space-y-space-xs">
                        <%= for relation <- @analysis_result.relations do %>
                          <div class="flex items-center gap-space-sm p-space-sm rounded-md bg-surface-sunk text-caption">
                            <span class="text-ref text-ink">{relation.from}</span>
                            <.icon name="hero-arrow-right" class="size-3 text-ink-muted" />
                            <.badge variant={:default} size={:xs}>{relation.type}</.badge>
                            <.icon name="hero-arrow-right" class="size-3 text-ink-muted" />
                            <span class="text-ref text-ink">{relation.to}</span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-center py-space-2xl">
                  <div class="inline-flex items-center justify-center size-12 rounded-md bg-red-wash mb-space-md">
                    <.icon name="hero-exclamation-triangle" class="size-6 text-red" />
                  </div>
                  <p class="text-subheading text-red">Analysis Failed</p>
                  <p class="text-term text-ink mt-space-xs">{@analysis_result.error}</p>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-space-3xl">
                <div class="inline-flex items-center justify-center size-16 rounded-md bg-surface-sunk mb-space-lg">
                  <.icon name="hero-beaker" class="size-8 text-ink-muted" />
                </div>
                <p class="text-subheading text-ink-muted">No analysis results yet</p>
                <p class="text-caption text-ink-muted mt-space-xs">Enter code and click Analyze to see results</p>
              </div>
            <% end %>
          </div>
        </.card>
      </div>
    <% end %>
  </div>
</.app_shell>
