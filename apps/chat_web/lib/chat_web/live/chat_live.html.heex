<div class="flex h-screen bg-ground text-ink">
  <!-- Mobile: Drawer toggles -->
  <div class="lg:hidden fixed top-0 left-0 right-0 z-20 flex items-center justify-between p-space-sm bg-surface border-b border-border">
    <.icon_btn phx-click={JS.toggle(to: "#left-drawer")} title="Conversations">
      <.icon name="hero-bars-3" class="size-5" />
    </.icon_btn>
    <span class="text-subheading text-ink">Chat Bot</span>
    <.icon_btn phx-click={JS.toggle(to: "#right-drawer")} title="Inspector">
      <.icon name="hero-adjustments-horizontal" class="size-5" />
    </.icon_btn>
  </div>

<!-- Left Pane: Conversations (desktop: always visible, mobile: drawer) -->
  <aside
    id="left-drawer"
    class="hidden lg:flex flex-col w-80 shrink-0 bg-surface border-r border-border
           fixed lg:relative inset-y-0 left-0 z-30 lg:z-auto"
  >
    <!-- Brand & Status Header -->
    <div class="p-space-lg border-b border-border">
      <div class="flex items-center justify-between">
        <h1 class="text-title text-ink">Chat Bot</h1>
        <.icon_btn class="lg:hidden" phx-click={JS.toggle(to: "#left-drawer")} title="Close">
          <.icon name="hero-x-mark" class="size-5" />
        </.icon_btn>
      </div>

<!-- Status Summary -->
      <div class="mt-space-md text-body-dense text-ink-muted space-y-space-xs">
        <div class="flex items-center justify-between">
          <span>Status:</span>
          <.badge variant={if @status.is_shutting_down, do: :default, else: :success}>
            {if @status.is_shutting_down, do: "Shutting Down", else: "Active"}
          </.badge>
        </div>
        <div class="flex items-center justify-between">
          <span>Conversations:</span>
          <span class="text-value-strong text-ink">{@status.active_conversations}</span>
        </div>
        <div class="flex items-center justify-between">
          <span>Memory:</span>
          <span class="text-value-strong text-ink">{@status.global_memory_size} entries</span>
        </div>
      </div>
    </div>

<!-- System Status Section -->
    <div class="p-space-lg border-b border-border">
      <.section_header icon="hero-cpu-chip">
        System Status
      </.section_header>

      <div class="mt-space-md space-y-space-sm">
        <%= if Brain.SystemStatus.all_ready?() do %>
          <div class="flex items-center gap-space-sm text-caption text-ink">
            <.status_dot status={:ready} />
            <span>All systems ready</span>
          </div>
        <% else %>
          <div class="flex items-center gap-space-sm text-caption text-ink-muted">
            <.status_dot status={:initializing} pulse />
            <span>Initializing...</span>
          </div>
        <% end %>

        <div class="ml-space-lg space-y-space-xs text-caption">
          <div class="flex items-center gap-space-sm">
            <.status_dot
              status={if @system_status.embedder.ready, do: :ready, else: :initializing}
              pulse={not @system_status.embedder.ready}
              size={:sm}
            />
            <span class={[
              "text-ink-muted",
              not @system_status.embedder.ready && "italic"
            ]}>
              Embedder: {@system_status.embedder.label}
            </span>
          </div>
          <div class="flex items-center gap-space-sm">
            <.status_dot
              status={if @system_status.nlp_pipeline.ready, do: :ready, else: :initializing}
              pulse={not @system_status.nlp_pipeline.ready}
              size={:sm}
            />
            <span class={[
              "text-ink-muted",
              not @system_status.nlp_pipeline.ready && "italic"
            ]}>
              NLP: {@system_status.nlp_pipeline.label}
            </span>
          </div>
          <div class="flex items-center gap-space-sm">
            <.status_dot
              status={if @system_status.brain.ready, do: :ready, else: :not_started}
              size={:sm}
            />
            <span class="text-ink-muted">
              Brain: {@system_status.brain.label}
            </span>
          </div>
          <div class="flex items-center gap-space-sm">
            <.status_dot
              status={if Brain.ML.MicroClassifiers.ready?(), do: :ready, else: :not_started}
              size={:sm}
            />
            <span class="text-ink-muted">
              Classifiers: {if Brain.ML.MicroClassifiers.ready?(), do: "ready", else: "loading"}
            </span>
          </div>
        </div>
      </div>

<!-- Cognitive Memory Stats -->
      <div class="mt-space-lg pt-space-md border-t border-border">
        <div class="text-label text-ink-muted mb-space-sm">
          Cognitive Memory
        </div>
        <div class="grid grid-cols-2 gap-space-sm text-caption">
          <div class="flex justify-between">
            <span class="text-ink-muted">Episodes:</span>
            <span class="text-value text-score-count">{@memory_stats.episode_count}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-ink-muted">Semantic:</span>
            <span class="text-value text-score-count">{@memory_stats.semantic_count}</span>
          </div>
        </div>
      </div>
    </div>

<!-- World Selector -->
    <div class="p-space-lg border-b border-border">
      <.section_header icon="hero-globe-alt">
        Training World
      </.section_header>

      <div class="mt-space-md flex gap-space-sm">
        <select
          class="flex-1 h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink"
          phx-change="switch_world"
          name="world_id"
        >
          <%= for world <- @available_worlds do %>
            <option value={world.id} selected={world.id == @current_world_id}>
              {world.name}
            </option>
          <% end %>
        </select>
        <.icon_btn size={:sm} phx-click="refresh_worlds" title="Refresh worlds">
          <.icon name="hero-arrow-path" class="size-4" />
        </.icon_btn>
      </div>

      <div class="mt-space-sm text-caption text-ink-muted">
        Current: <span class="text-ref text-ink">{@current_world_id}</span>
      </div>
    </div>

<!-- Actions -->
    <div class="p-space-lg space-y-space-sm">
      <.btn variant={:primary} class="w-full" phx-click="new_conversation">
        <.icon name="hero-plus" class="size-4" /> New Conversation
      </.btn>

      <div class="flex gap-space-sm">
        <.btn
          variant={if @show_processing, do: :secondary, else: :outline}
          size={:sm}
          class="flex-1"
          phx-click="toggle_processing"
        >
          <.icon name="hero-cpu-chip" class="size-4" /> Processing
        </.btn>
        <.btn
          variant={if @show_knowledge, do: :secondary, else: :outline}
          size={:sm}
          class="flex-1"
          phx-click="toggle_knowledge"
        >
          <.icon name="hero-light-bulb" class="size-4" /> Knowledge
        </.btn>
      </div>

      <.btn variant={:link} size={:sm} navigate={~p"/admin"} icon="hero-cog-6-tooth">
        Entity Management
      </.btn>
    </div>

<!-- Conversations List -->
    <div class="flex-1 overflow-y-auto p-space-lg pt-0">
      <.section_header icon="hero-chat-bubble-left-right" class="mb-space-md">
        Conversations
      </.section_header>

      <div class="space-y-space-xs">
        <%= for conversation <- @conversations do %>
          <button
            type="button"
            class={[
              "w-full text-left p-space-md rounded-sm transition-colors cursor-pointer",
              if(@current_conversation_id == conversation.id,
                do: "bg-accent-wash border-l-[length:var(--stroke-mark)] border-accent",
                else: "hover:bg-surface-sunk"
              )
            ]}
            phx-click="select_conversation"
            phx-value-conversation_id={conversation.id}
          >
            <div class={[
              "text-body-dense font-semibold",
              if(@current_conversation_id == conversation.id, do: "text-accent", else: "text-ink")
            ]}>
              Conversation {String.slice(conversation.id, 0, 8)}
            </div>
            <div class="text-caption text-ink-muted mt-space-2xs">
              {conversation.message_count} messages
            </div>
          </button>
        <% end %>

        <%= if length(@conversations) == 0 do %>
          <div class="text-body-dense text-ink-muted italic text-center py-space-lg">
            No conversations yet
          </div>
        <% end %>
      </div>
    </div>
  </aside>

<!-- Center Pane: Chat -->
  <main class="flex-1 flex flex-col min-w-0 pt-12 lg:pt-0">
    <!-- Chat Header -->
    <header class="shrink-0 bg-surface border-b border-border px-space-lg py-space-md lg:px-space-xl">
      <div class="flex items-center justify-between max-w-4xl mx-auto">
        <div class="min-w-0">
          <h2 class="text-heading text-ink">
            <%= if @current_conversation_id do %>
              Conversation {String.slice(@current_conversation_id, 0, 8)}
            <% else %>
              Start a new conversation
            <% end %>
          </h2>
          <p class="text-body-dense text-ink-muted">
            {@status.name} - {Enum.join(@status.traits, ", ")}
          </p>
        </div>

        <%= if @current_conversation_id do %>
          <% conversation_target = "conversation #{String.slice(@current_conversation_id, 0, 8)}" %>
          <div class="flex flex-col items-end gap-space-sm">
            <.btn
              id="end-conversation"
              variant={:outline}
              size={:sm}
              reach={:shared}
              target={conversation_target}
              phx-click="open_confirm"
              phx-value-id="end-conversation-confirm"
            >
              End Conversation
            </.btn>
            <.execute_confirm
              id="end-conversation-confirm"
              open={@open_confirm == "end-conversation-confirm"}
              reach={:shared}
              verb="End conversation"
              target={conversation_target}
              consequence="Removes this conversation from the Brain server, so it leaves the conversation list every session reads."
              on_confirm="end_conversation"
              on_cancel="close_confirm"
              trigger_id="end-conversation"
              error={@confirm_error}
            />
          </div>
        <% end %>
      </div>
    </header>

<!-- Messages Area -->
    <div class="flex-1 overflow-y-auto">
      <div class="max-w-4xl mx-auto p-space-lg lg:p-space-xl space-y-space-lg">
        <!-- System Initialization Banner -->
        <%= if not Brain.SystemStatus.all_ready?() do %>
          <.alert variant={:warning}>
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-arrow-path" class="size-4 motion-safe:animate-spin text-progress-fill" />
              <span>
                <span class="font-semibold">System initializing...</span>
                <span class="hidden sm:inline">
                  You can chat, but some features may be limited.
                </span>
              </span>
            </div>
          </.alert>
        <% end %>

<!-- World Models Loading/Warning Banner -->
        <%= if @world_models_loading do %>
          <.alert variant={:info}>
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-arrow-path" class="size-4 motion-safe:animate-spin text-progress-fill" />
              <span>
                <span class="font-semibold">Loading world models...</span>
              </span>
            </div>
          </.alert>
        <% end %>

        <%= if @world_models_status && not @world_models_status.has_classifier && not @world_models_loading do %>
          <.alert variant={:warning}>
            <div class="flex items-center gap-space-sm">
              <.icon name="hero-exclamation-triangle" class="size-4" />
              <span>
                <span class="font-semibold">No trained models for "{@current_world_id}"</span>
                <span class="hidden sm:inline">
                  Using default models. Train world-specific models with:
                  <code class="px-space-xs bg-surface rounded-sm text-ref text-ink">
                    mix train_models --world {@current_world_id}
                  </code>
                </span>
              </span>
            </div>
          </.alert>
        <% end %>

        <%= if @error_message do %>
          <.alert variant={:error}>
            {@error_message}
          </.alert>
        <% end %>

        <%= if length(@messages) == 0 do %>
          <div class="text-center text-ink-muted py-space-3xl">
            <.icon name="hero-chat-bubble-left-right" class="size-12 mx-auto mb-space-md" />
            <p class="text-heading">No messages yet</p>
            <p class="text-body-dense mt-space-xs">Start a conversation!</p>
          </div>
        <% else %>
          <%= for message <- @messages do %>
            <% analysis_steps = @analysis_logs[message.id] || [] %>
            <% dev = @analysis_details[message.id] || %{} %>
            <% is_selected = @selected_message_id == message.id %>

            <div class={[
              "flex flex-col gap-space-sm",
              if(message.role == "user", do: "items-end", else: "items-start")
            ]}>
              <!-- Message Bubble -->
              <%= if message.role == "user" && @show_processing do %>
                <button
                  type="button"
                  phx-click="select_message"
                  phx-value-message_id={message.id}
                  class={[
                    "max-w-[85%] lg:max-w-xl px-space-lg py-space-md rounded-md border text-left text-ink transition-colors cursor-pointer",
                    if(is_selected,
                      do: "bg-accent-wash border-accent",
                      else: "bg-surface-sunk border-border-strong hover:bg-primary-wash"
                    )
                  ]}
                >
                  <div class="text-body-dense whitespace-pre-wrap">{message.content}</div>
                  <div class="text-caption mt-space-sm text-ink-muted">
                    {Calendar.strftime(DateTime.from_unix!(div(message.timestamp, 1000)), "%H:%M")}
                  </div>
                </button>
              <% else %>
                <div class={[
                  "max-w-[85%] lg:max-w-xl px-space-lg py-space-md rounded-md border text-ink",
                  if(message.role == "user",
                    do: "bg-surface-sunk border-border-strong",
                    else: "bg-surface border-border"
                  )
                ]}>
                  <div class="text-body-dense whitespace-pre-wrap">{message.content}</div>
                  <div class="text-caption mt-space-sm text-ink-muted">
                    {Calendar.strftime(DateTime.from_unix!(div(message.timestamp, 1000)), "%H:%M")}
                  </div>
                </div>
              <% end %>

<!-- Processing Summary Pill (for user messages) -->
              <%= if message.role == "user" && @show_processing && length(analysis_steps) > 0 do %>
                <button
                  type="button"
                  phx-click="select_message"
                  phx-value-message_id={message.id}
                  class={[
                    "flex items-center gap-space-sm text-caption px-space-sm py-space-xs rounded-sm border transition-colors cursor-pointer",
                    if(is_selected,
                      do: "bg-accent-wash border-accent text-accent",
                      else: "bg-surface-sunk border-border text-ink-muted hover:border-border-strong"
                    )
                  ]}
                  title="Click to inspect processing details"
                >
                  <.icon name="hero-cpu-chip" class="size-3" />
                  <span class="font-semibold">
                    {(dev[:overall_strategy] && step_label(dev.overall_strategy)) || "Processing"}
                  </span>
                  <%= if dev[:elapsed_ms] do %>
                    <span class="text-value text-ink-muted">{dev.elapsed_ms}ms</span>
                  <% end %>
                  <%= if is_selected do %>
                    <.icon name="hero-arrow-right" class="size-3" />
                  <% end %>
                </button>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

<!-- Input Area -->
    <div class="shrink-0 bg-surface border-t border-border p-space-lg">
      <form
        id="message-form"
        phx-submit="send_message"
        phx-change="input_change"
        class="max-w-4xl mx-auto flex items-start gap-space-md"
      >
        <div class="flex-1 min-w-0">
          <.input
            id="message-input"
            name="input"
            value={@input_text}
            label="Message"
            inline
            placeholder="Type your message..."
            autocomplete="off"
            required
            minlength="1"
            pattern=".*\S.*"
            title="A message needs at least one character that is not a space."
            aria-invalid={@input_error && "true"}
            errors={List.wrap(@input_error)}
          />
        </div>
        <.btn type="submit" variant={:primary} disabled={String.trim(@input_text) == ""}>
          <.icon name="hero-paper-airplane" class="size-4" />
          <span class="hidden sm:inline">Send</span>
        </.btn>
      </form>
    </div>
  </main>

<!-- Right Pane: Inspector (desktop: always visible when content, mobile: drawer) -->
  <aside
    id="right-drawer"
    class="hidden lg:flex flex-col w-96 shrink-0 bg-surface border-l border-border
           fixed lg:relative inset-y-0 right-0 z-30 lg:z-auto overflow-hidden"
  >
    <!-- Inspector Header -->
    <div class="shrink-0 p-space-lg border-b border-border flex items-center justify-between">
      <.section_header icon="hero-magnifying-glass-circle">
        Inspector
      </.section_header>
      <.icon_btn class="lg:hidden" phx-click={JS.toggle(to: "#right-drawer")} title="Close">
        <.icon name="hero-x-mark" class="size-5" />
      </.icon_btn>
    </div>

<!-- Inspector Content -->
    <div class="flex-1 overflow-y-auto">
      <%= if @selected_message_id do %>
        <% dev = @analysis_details[@selected_message_id] || %{} %>
        <% analysis_steps = @analysis_logs[@selected_message_id] || [] %>
        <% active_tab = @dev_panel_tabs[@selected_message_id] || "stages" %>

<!-- Tabs - Compact scrollable design -->
        <div class="border-b border-border">
          <!-- Tab Groups -->
          <div class="px-space-sm pt-space-sm pb-space-xs">
            <div class="text-label text-ink-muted mb-space-xs px-space-xs">
              Analysis
            </div>
            <.tabs class="flex-wrap">
              <.tab
                active={active_tab == "stages"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="stages"
                title="Processing stages timeline"
              >
                <.icon name="hero-queue-list" class="size-3 inline mr-space-xs" />Stages
              </.tab>
              <.tab
                active={active_tab == "chunks"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="chunks"
                title="Semantic chunks breakdown"
              >
                <.icon name="hero-squares-2x2" class="size-3 inline mr-space-xs" />Chunks
              </.tab>
              <.tab
                active={active_tab == "entities"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="entities"
                title="Extracted entities"
              >
                <.icon name="hero-tag" class="size-3 inline mr-space-xs" />Entities
              </.tab>
              <.tab
                active={active_tab == "context"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="context"
                title="Slot and context resolution"
              >
                <.icon name="hero-link" class="size-3 inline mr-space-xs" />Context
              </.tab>
            </.tabs>
          </div>

          <div class="px-space-sm pb-space-sm">
            <div class="text-label text-ink-muted mb-space-xs px-space-xs">
              Decision
            </div>
            <.tabs class="flex-wrap">
              <.tab
                active={active_tab == "strategy"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="strategy"
                title="Response strategy reasoning"
              >
                <.icon name="hero-map" class="size-3 inline mr-space-xs" />Strategy
              </.tab>
              <.tab
                active={active_tab == "racing"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="racing"
                title="Racing analyzer results"
              >
                <.icon name="hero-bolt" class="size-3 inline mr-space-xs" />Racing
              </.tab>
              <.tab
                active={active_tab == "memory"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="memory"
                title="Memory similarity matches"
              >
                <.icon name="hero-circle-stack" class="size-3 inline mr-space-xs" />Memory
              </.tab>
              <.tab
                active={active_tab == "response"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="response"
                title="Response generation path"
              >
                <.icon name="hero-chat-bubble-left-right" class="size-3 inline mr-space-xs" />Response
              </.tab>
              <.tab
                active={active_tab == "raw"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="raw"
                title="Raw debug data"
              >
                <.icon name="hero-code-bracket" class="size-3 inline mr-space-xs" />Raw
              </.tab>
            </.tabs>
          </div>

          <div class="px-space-sm pb-space-sm">
            <div class="text-label text-ink-muted mb-space-xs px-space-xs">
              Epistemic
            </div>
            <.tabs class="flex-wrap">
              <.tab
                active={active_tab == "beliefs"}
                phx-click="set_dev_tab"
                phx-value-message_id={@selected_message_id}
                phx-value-tab="beliefs"
                title="Beliefs checked during fact verification"
              >
                <.icon name="hero-eye" class="size-3 inline mr-space-xs" />Beliefs
              </.tab>
            </.tabs>
          </div>
        </div>

<!-- Tab Content -->
        <div class="p-space-lg">
          <%= if active_tab == "stages" do %>
            <div class="space-y-space-sm">
              <div class="flex items-center justify-between text-caption text-ink-muted mb-space-md">
                <span>Processing stages ({length(analysis_steps)} steps)</span>
                <%= if dev[:elapsed_ms] do %>
                  <.badge variant={:info}><span class="text-value">{dev.elapsed_ms}ms</span></.badge>
                <% end %>
              </div>

              <div class="space-y-space-xs max-h-[600px] overflow-y-auto">
                <%= for step <- analysis_steps do %>
                  <% step_name = step[:step] || step["step"]
                  step_icon = stage_icon(step_name)
                  step_detail = stage_detail(step)
                  step_score = stage_score_spec(step) %>
                  <div class="flex items-start gap-space-sm py-space-xs px-space-sm rounded-sm text-caption bg-surface-sunk">
                    <span class="shrink-0 mt-space-2xs">{step_icon}</span>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between gap-space-sm">
                        <span class="text-ink font-semibold capitalize truncate">
                          {step_label(step_name)}
                        </span>
                        <div class="flex items-center gap-space-sm text-ink-muted shrink-0">
                          <%= if step[:chunk_index] != nil do %>
                            <span class="px-space-xs py-space-2xs bg-surface rounded-sm text-caption">
                              C{step.chunk_index + 1}
                            </span>
                          <% end %>
                          <%= if dev[:started_at] && step[:timestamp] do %>
                            <span class="text-offset">
                              +{step.timestamp - dev.started_at}ms
                            </span>
                          <% end %>
                        </div>
                      </div>
                      <%= if step_detail != "" or step_score do %>
                        <div class="flex flex-wrap items-baseline gap-x-space-sm text-caption text-ink-muted mt-space-2xs">
                          <span :if={step_detail != ""} class="min-w-0 truncate">{step_detail}</span>
                          <.stage_score :if={step_score} spec={step_score} />
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%= if active_tab == "chunks" do %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <%= for {idx, chunk} <- Enum.sort_by(Map.get(dev, :chunks, %{}), fn {i, _} -> i end) do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="flex items-center justify-between mb-space-sm">
                      <span class="text-caption font-semibold text-ink">
                        Chunk {idx + 1}
                      </span>
                      <%= if chunk[:response_strategy] do %>
                        <.badge variant={strategy_badge_variant(chunk.response_strategy)} size={:xs}>
                          {step_label(chunk.response_strategy)}
                        </.badge>
                      <% end %>
                    </div>

<!-- Chunk Text -->
                    <%= if chunk[:chunk_text] do %>
                      <div class="mb-space-md p-space-sm bg-surface-sunk rounded-sm text-term text-ink border-l-[length:var(--stroke-mark)] border-border-strong">
                        "{chunk.chunk_text}"
                      </div>
                    <% end %>

                    <div class="space-y-space-sm text-caption text-ink-muted">
                      <!-- Intent with method -->
                      <div class="p-space-sm bg-surface-sunk rounded-sm">
                        <div class="font-semibold text-ink mb-space-xs">
                          Intent Classification
                        </div>
                        <div class="grid grid-cols-2 gap-space-xs">
                          <span class="text-ink-muted">Intent:</span>
                          <span class="text-value text-ink">{chunk[:intent] || "-"}</span>
                          <span class="text-ink-muted">Method:</span>
                          <span class="text-value text-ink">{chunk[:intent_method] || "-"}</span>
                          <%= if chunk[:intent_method] do %>
                            <span class="text-ink-muted">Confidence:</span>
                            <.intent_confidence method={chunk.intent_method} confidence={chunk[:intent_confidence]} />
                          <% end %>
                        </div>
                      </div>

<!-- Discourse -->
                      <% discourse_confidence = get_in(chunk, [:discourse, :confidence]) %>
                      <div class="p-space-sm bg-surface-sunk rounded-sm">
                        <div class="font-semibold text-ink mb-space-xs">Discourse Analysis</div>
                        <div class="grid grid-cols-2 gap-space-xs">
                          <span class="text-ink-muted">Addressee:</span>
                          <span class="text-ink">{get_in(chunk, [:discourse, :addressee]) || "-"}</span>
                          <span class="text-ink-muted">Confidence:</span>
                          <%= if discourse_confidence != nil do %>
                            <.score_display value={discourse_confidence} kind={:mapped_confidence} />
                          <% else %>
                            <span class="text-ink">-</span>
                          <% end %>
                        </div>
                      </div>

<!-- Speech Act -->
                      <% speech_act_confidence = get_in(chunk, [:speech_act, :confidence]) %>
                      <div class="p-space-sm bg-surface-sunk rounded-sm">
                        <div class="font-semibold text-ink mb-space-xs">Speech Act</div>
                        <div class="grid grid-cols-2 gap-space-xs">
                          <span class="text-ink-muted">Category:</span>
                          <span class="text-ink">{get_in(chunk, [:speech_act, :category]) || "-"}</span>
                          <span class="text-ink-muted">Sub-type:</span>
                          <span class="text-ink">{get_in(chunk, [:speech_act, :sub_type]) || "-"}</span>
                          <span class="text-ink-muted">Is question:</span>
                          <span class="text-ink">{get_in(chunk, [:speech_act, :is_question]) || "false"}</span>
                          <span class="text-ink-muted">Confidence:</span>
                          <%= if speech_act_confidence != nil do %>
                            <.score_display value={speech_act_confidence} kind={:weighted_vote} />
                          <% else %>
                            <span class="text-ink">-</span>
                          <% end %>
                        </div>
                      </div>

<!-- Sentiment Analysis -->
                      <% sentiment_confidence = get_in(chunk, [:sentiment, :confidence]) %>
                      <div class="p-space-sm bg-surface-sunk rounded-sm">
                        <div class="font-semibold text-ink mb-space-xs">Sentiment</div>
                        <div class="grid grid-cols-2 gap-space-xs">
                          <span class="text-ink-muted">Label:</span>
                          <span class="text-ink font-semibold">
                            {get_in(chunk, [:sentiment, :label]) || "-"}
                          </span>
                          <span class="text-ink-muted">Confidence:</span>
                          <%= if sentiment_confidence != nil do %>
                            <.score_display value={sentiment_confidence} kind={:cosine_similarity} />
                          <% else %>
                            <span class="text-ink">-</span>
                          <% end %>
                        </div>
                      </div>

<!-- Events -->
                      <% events_data = chunk[:events] || %{} %>
                      <div class="p-space-sm bg-surface-sunk rounded-sm">
                        <div class="font-semibold text-ink mb-space-xs flex items-center justify-between">
                          <span>Events</span>
                          <span class="text-ink-muted font-normal">
                            <span class="text-value text-score-count">{events_data[:event_count] || 0}</span> found
                          </span>
                        </div>
                        <%= if length(events_data[:events] || []) > 0 do %>
                          <div class="space-y-space-xs mt-space-xs">
                            <%= for event <- (events_data[:events] || []) do %>
                              <% event_confidence = event[:confidence] || event["confidence"] %>
                              <div class="p-space-xs bg-surface rounded-sm text-caption">
                                <div class="flex items-center justify-between gap-space-xs">
                                  <span class="text-value text-ink">
                                    {event[:type] || event["type"] || "unknown"}
                                  </span>
                                  <%= if event_confidence do %>
                                    <.event_confidence event={event} />
                                  <% end %>
                                </div>
                                <%= if event[:action] || event["action"] do %>
                                  <div class="text-ink-muted mt-space-2xs">
                                    {event[:action] || event["action"]}
                                  </div>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                        <% else %>
                          <div class="text-ink-muted italic text-caption">
                            No events detected
                          </div>
                        <% end %>
                      </div>

<!-- Epistemic Context -->
                      <div class="p-space-sm bg-surface-sunk rounded-sm border border-border">
                        <div class="font-semibold text-ink mb-space-xs flex items-center gap-space-xs">
                          <span class="text-ink-muted">●</span> Epistemic Context
                        </div>
                        <div class="grid grid-cols-2 gap-space-xs">
                          <span class="text-ink-muted">Status:</span>
                          <.epistemic_status_label status={chunk[:epistemic_status]} />
                          <span class="text-ink-muted">Verification:</span>
                          <span class="text-caption text-ink"><.verification_result verification={chunk[:fact_verification]} /></span>
                          <span class="text-ink-muted">Related beliefs:</span>
                          <span class="text-ink">
                            <span class="text-value text-score-count">{length(chunk[:related_beliefs] || [])}</span> beliefs
                          </span>
                        </div>
                      </div>

<!-- Overall Confidence -->
                      <%= if chunk[:confidence] do %>
                        <div class="flex justify-between items-center gap-space-sm pt-space-sm border-t border-border">
                          <span class="font-semibold">Overall Confidence:</span>
                          <.score_display value={chunk.confidence} kind={:accumulated_confidence} />
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% end %>
            </div>
          <% end %>

          <%= if active_tab == "entities" do %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <%= for {idx, chunk} <- Enum.sort_by(Map.get(dev, :chunks, %{}), fn {i, _} -> i end) do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="flex items-center justify-between mb-space-sm">
                      <span class="font-semibold text-caption text-ink">
                        Chunk {idx + 1}
                      </span>
                      <.badge variant={:default} size={:xs}>
                        {length(chunk[:entities] || [])} entities
                      </.badge>
                    </div>

<!-- Chunk text context -->
                    <%= if chunk[:chunk_text] do %>
                      <div class="mb-space-md p-space-sm bg-surface-sunk rounded-sm text-term text-ink-muted border-l-[length:var(--stroke-mark)] border-border-strong">
                        "{chunk.chunk_text}"
                      </div>
                    <% end %>

<!-- Extracted Entities -->
                    <div class="mb-space-md">
                      <div class="text-caption font-semibold text-ink mb-space-sm">
                        Extracted Entities
                      </div>
                      <%= if length(chunk[:entities] || []) > 0 do %>
                        <div class="space-y-space-xs">
                          <%= for e <- chunk.entities do %>
                            <% entity_type = e[:type] || e["type"] || "unknown"
                            entity_value = e[:value] || e["value"] || ""
                            confidence = e[:confidence] || e["confidence"]
                            source = e[:source] || e["source"]

                            source_label = case source do
                              :lstm_ner -> "NER"
                              :gazetteer -> "Gaz"
                              :pos_tagger -> "POS"
                              :system -> "Sys"
                              nil -> nil
                              other -> to_string(other) |> String.slice(0..3)
                            end %>
                            <div class="flex items-center justify-between p-space-sm bg-surface-sunk rounded-sm text-caption gap-space-sm">
                              <div class="flex flex-wrap items-center gap-space-sm flex-1 min-w-0">
                                <span class="text-term text-ink">
                                  {entity_type}
                                </span>
                                <%= if source_label do %>
                                  <.badge variant={:info} size={:xs}>
                                    {source_label}
                                  </.badge>
                                <% end %>
                                <%= if confidence do %>
                                  <.entity_confidence source={source} confidence={confidence} />
                                <% end %>
                              </div>
                              <div class="font-semibold text-ink truncate">
                                "{entity_value}"
                              </div>
                            </div>
                          <% end %>
                        </div>
                      <% else %>
                        <div class="text-caption text-ink-muted italic p-space-sm bg-surface-sunk rounded-sm">
                          No entities extracted from this chunk
                        </div>
                      <% end %>
                    </div>

<!-- Slot Filling -->
                    <% slots = chunk[:slots_detected] || %{} %>
                    <div class="pt-space-md border-t border-border">
                      <div class="text-caption font-semibold text-ink mb-space-sm">
                        Slot Filling
                      </div>
                      <div class="grid grid-cols-2 gap-space-sm text-caption mb-space-sm">
                        <div class="flex justify-between">
                          <span class="text-ink-muted">Filled:</span>
                          <span class="text-value-strong text-score-count">
                            {slots[:filled_count] || 0}
                          </span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-ink-muted">Missing:</span>
                          <span class={
                            if length(slots[:missing_required] || []) > 0,
                              do: "text-value-strong text-ochre",
                              else: "text-value text-ink-muted"
                          }>
                            {length(slots[:missing_required] || [])}
                          </span>
                        </div>
                      </div>

                      <%= if map_size(slots[:filled_slots] || %{}) > 0 do %>
                        <div class="space-y-space-xs text-caption">
                          <%= for {k, v} <- slots.filled_slots do %>
                            <div class="flex items-center gap-space-sm p-space-xs bg-surface-sunk rounded-sm text-ink">
                              <.icon name="hero-check-circle" class="size-3" />
                              <span class="text-term">{k}:</span>
                              <span class="font-semibold">{inspect(v)}</span>
                            </div>
                          <% end %>
                        </div>
                      <% end %>

                      <%= if length(slots[:missing_required] || []) > 0 do %>
                        <div class="mt-space-sm space-y-space-xs text-caption">
                          <%= for slot <- slots.missing_required do %>
                            <div class="flex items-center gap-space-sm p-space-xs bg-ochre-wash rounded-sm text-ochre">
                              <.icon name="hero-exclamation-triangle" class="size-3" />
                              <span class="text-term">{slot}</span>
                              <span class="text-ink-muted">- required but missing</span>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% end %>
            </div>
          <% end %>

          <%= if active_tab == "context" do %>
            <div class="space-y-space-md max-h-96 overflow-y-auto">
              <%= for {idx, chunk} <- Enum.sort_by(Map.get(dev, :chunks, %{}), fn {i, _} -> i end) do %>
                <% ctx = chunk[:context_resolved] || %{} %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="font-semibold text-caption text-ink mb-space-sm">
                      Chunk {idx + 1}
                    </div>
                    <div class="text-caption text-ink-muted space-y-space-xs">
                      <div>
                        <span class="font-semibold">All required filled:</span>
                        <%= if ctx[:all_required_filled] do %>
                          <.badge variant={:success} size={:xs}>Yes</.badge>
                        <% else %>
                          <.badge variant={:warning} size={:xs}>No</.badge>
                        <% end %>
                      </div>
                      <%= if map_size(ctx[:filled_slots] || %{}) > 0 do %>
                        <div class="mt-space-sm space-y-space-2xs">
                          <%= for {k, v} <- ctx.filled_slots do %>
                            <div class="text-ink">
                              <.icon name="hero-check" class="size-3 inline" /> {k}: {inspect(v)}
                            </div>
                          <% end %>
                        </div>
                      <% else %>
                        <div class="text-ink-muted italic mt-space-xs">
                          No slots filled from context
                        </div>
                      <% end %>
                      <%= if length(ctx[:missing_required] || []) > 0 do %>
                        <div class="mt-space-sm text-ochre">
                          Still missing: {Enum.join(ctx.missing_required, ", ")}
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% end %>
            </div>
          <% end %>

          <%= if active_tab == "strategy" do %>
            <% reasoning = dev[:strategy_reasoning] || %{} %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption text-ink-muted space-y-space-sm">
                    <div class="flex justify-between">
                      <span class="font-semibold">Overall strategy:</span>
                      <.badge variant={strategy_badge_variant(dev[:overall_strategy])}>
                        {(dev[:overall_strategy] && step_label(dev.overall_strategy)) || "-"}
                      </.badge>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Elapsed:</span>
                      <span class="text-value text-ink">{dev[:elapsed_ms] || "-"}ms</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Chunk count:</span>
                      <span class="text-value text-score-count">{dev[:chunk_count] || "-"}</span>
                    </div>
                  </div>

                  <.divider class="my-space-md" />

<!-- Strategy Reasoning Section -->
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Decision Reasoning
                  </div>
                  <div class="p-space-sm bg-surface-sunk rounded-sm text-caption mb-space-md">
                    <div class="text-ink font-semibold mb-space-sm">
                      {reasoning[:decision_reason] || "No reasoning available"}
                    </div>
                    <div class="grid grid-cols-2 gap-space-sm text-ink-muted">
                      <div class="flex items-center gap-space-xs">
                        <%= if reasoning[:has_expressives] do %>
                          <.icon name="hero-check-circle" class="size-3 text-ink" />
                        <% else %>
                          <.icon name="hero-x-circle" class="size-3 text-ink-muted" />
                        <% end %>
                        <span>Expressives</span>
                      </div>
                      <div class="flex items-center gap-space-xs">
                        <%= if reasoning[:has_substantive] do %>
                          <.icon name="hero-check-circle" class="size-3 text-ink" />
                        <% else %>
                          <.icon name="hero-x-circle" class="size-3 text-ink-muted" />
                        <% end %>
                        <span>Substantive</span>
                      </div>
                    </div>
                    <%= if (reasoning[:missing_slots_count] || 0) > 0 do %>
                      <div class="mt-space-sm text-ochre">
                        <.icon name="hero-exclamation-triangle" class="size-3 inline" />
                        Missing {reasoning.missing_slots_count} slot(s): {Enum.join(
                          reasoning[:missing_slots] || [],
                          ", "
                        )}
                      </div>
                    <% end %>
                  </div>

                  <%= if length(reasoning[:suggested_prompts] || []) > 0 do %>
                    <div class="text-caption font-semibold text-ink mb-space-sm">
                      Suggested Clarifications
                    </div>
                    <div class="space-y-space-xs mb-space-md">
                      <%= for prompt <- reasoning.suggested_prompts do %>
                        <div class="p-space-sm bg-surface-sunk rounded-sm text-caption text-ink border-l-[length:var(--stroke-mark)] border-border-strong">
                          {prompt}
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                  <.divider class="my-space-md" />

                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Per-chunk Decision Summary
                  </div>
                  <div class="space-y-space-sm">
                    <%= for {idx, chunk} <- Enum.sort_by(Map.get(dev, :chunks, %{}), fn {i, _} -> i end) do %>
                      <div class="p-space-sm bg-surface-sunk rounded-sm text-caption">
                        <div class="flex items-center justify-between mb-space-xs">
                          <span class="font-semibold text-ink">Chunk {idx + 1}</span>
                          <.badge
                            variant={strategy_badge_variant(chunk[:response_strategy])}
                            size={:xs}
                          >
                            {(chunk[:response_strategy] && step_label(chunk.response_strategy)) ||
                              "-"}
                          </.badge>
                        </div>
                        <div class="grid grid-cols-2 gap-space-xs text-ink-muted">
                          <span>Intent:</span>
                          <span class="text-value text-ink">{chunk[:intent] || "-"}</span>
                          <span>Method:</span>
                          <span class="text-value text-ink">{chunk[:intent_method] || "-"}</span>
                          <span>Confidence:</span>
                          <%= if chunk[:confidence] do %>
                            <.score_display value={chunk.confidence} kind={:accumulated_confidence} />
                          <% else %>
                            <span class="text-ink">-</span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </.card_body>
              </.card>
            </div>
          <% end %>

          <%= if active_tab == "racing" do %>
            <% racing = dev[:racing] || %{} %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Racing Analyzers
                  </div>
                  <div class="text-caption text-ink-muted space-y-space-sm">
                    <div class="flex justify-between">
                      <span class="font-semibold">Fast Path:</span>
                      <%= if racing[:fast_path] do %>
                        <.badge variant={:success} size={:xs}>
                          {racing[:fast_path_source] || "hit"}
                        </.badge>
                      <% else %>
                        <.badge variant={:default} size={:xs}>No</.badge>
                      <% end %>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Early Exit:</span>
                      <%= if racing[:early_exit] do %>
                        <.badge variant={:info} size={:xs}>Yes</.badge>
                      <% else %>
                        <.badge variant={:default} size={:xs}>No</.badge>
                      <% end %>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Racing Time:</span>
                      <span class="text-value text-ink">{racing[:elapsed_ms] || "-"}ms</span>
                    </div>
                  </div>
                </.card_body>
              </.card>

              <%= if length(racing[:results] || []) > 0 do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="text-caption font-semibold text-ink mb-space-sm">
                      Analyzer Results
                    </div>
                    <div class="space-y-space-sm">
                      <%= for result <- racing.results do %>
                        <div class="p-space-sm bg-surface-sunk rounded-sm text-caption">
                          <div class="flex items-center justify-between gap-space-sm mb-space-xs">
                            <span class="font-semibold text-ink capitalize">
                              {result[:analyzer] || result["analyzer"]}
                            </span>
                            <.score_display
                              value={result[:calibrated] || result["calibrated"]}
                              kind={:analyzer_activation}
                            />
                          </div>
                          <div class="grid grid-cols-2 gap-space-xs text-ink-muted">
                            <span>Intent:</span>
                            <span class="text-value text-ink">
                              {result[:intent] || result["intent"] || "-"}
                            </span>
                            <span>Raw Score:</span>
                            <.score_display
                              value={result[:raw_score] || result["raw_score"]}
                              kind={:raw_score}
                              source={to_string(result[:analyzer] || result["analyzer"])}
                            />
                          </div>
                          <%= if length(result[:indicators] || result["indicators"] || []) > 0 do %>
                            <div class="mt-space-xs flex flex-wrap gap-space-xs">
                              <%= for indicator <- (result[:indicators] || result["indicators"] || []) do %>
                                <span class="px-space-xs py-space-2xs bg-surface border border-border rounded-sm text-caption text-ink-muted">
                                  {indicator}
                                </span>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% end %>

              <%= if length(racing[:alternatives] || []) > 0 do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="text-caption font-semibold text-ink mb-space-sm">
                      Alternative Interpretations
                    </div>
                    <div class="space-y-space-xs">
                      <%= for alt <- racing.alternatives do %>
                        <div class="flex items-center justify-between gap-space-sm p-space-sm bg-surface-sunk rounded-sm text-caption">
                          <span class="text-value text-ink">
                            {alt[:intent] || alt["intent"]}
                          </span>
                          <div class="flex items-center gap-space-sm">
                            <span class="text-ink-muted">
                              {alt[:source] || alt["source"]}
                            </span>
                            <.score_display value={alt[:activation] || alt["activation"]} kind={:activation} />
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% end %>
            </div>
          <% end %>

          <%= if active_tab == "memory" do %>
            <% memory = dev[:memory] || %{} %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Memory Query Results
                  </div>
                  <div class="text-caption text-ink-muted space-y-space-sm">
                    <div class="flex justify-between">
                      <span class="font-semibold">Matches Found:</span>
                      <span class="text-value-strong text-score-count">
                        {memory[:match_count] || 0}
                      </span>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Top Similarity:</span>
                      <%= if (memory[:match_count] || 0) > 0 do %>
                        <.score_display value={memory[:top_similarity]} kind={:cosine_similarity} />
                      <% else %>
                        <span class="text-ink-muted">no matches</span>
                      <% end %>
                    </div>
                  </div>
                </.card_body>
              </.card>

              <%= if length(memory[:matches] || []) > 0 do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="text-caption font-semibold text-ink mb-space-sm">
                      Similar Episodes
                    </div>
                    <div class="space-y-space-sm">
                      <%= for match <- memory.matches do %>
                        <div class="p-space-sm bg-surface-sunk rounded-sm text-caption">
                          <div class="flex items-center justify-between gap-space-sm mb-space-xs">
                            <span class="text-ref text-ink-muted">
                              {String.slice(
                                match[:episode_id] || match["episode_id"] || "",
                                0,
                                12
                              )}...
                            </span>
                            <.score_display
                              value={match[:similarity] || match["similarity"]}
                              kind={:cosine_similarity}
                            />
                          </div>
                          <%= if match[:state_preview] || match["state_preview"] do %>
                            <div class="p-space-xs bg-surface rounded-sm text-term text-ink-muted mb-space-xs">
                              "{match[:state_preview] || match["state_preview"]}"
                            </div>
                          <% end %>
                          <%= if length(match[:tags] || match["tags"] || []) > 0 do %>
                            <div class="flex flex-wrap gap-space-xs">
                              <%= for tag <- (match[:tags] || match["tags"] || []) do %>
                                <span class="px-space-xs py-space-2xs bg-surface border border-border rounded-sm text-caption text-ink-muted">
                                  {tag}
                                </span>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% else %>
                <div class="text-center text-ink-muted py-space-lg">
                  <.icon name="hero-circle-stack" class="size-8 mx-auto mb-space-sm" />
                  <p class="text-caption">No similar episodes found in memory</p>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= if active_tab == "response" do %>
            <% resp = dev[:response] || %{} %>
            <% path = resp[:response_path] || %{} %>
            <% path_steps = path[:steps] || [] %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Response Generation Summary
                  </div>
                  <div class="text-caption text-ink-muted space-y-space-sm">
                    <div class="flex justify-between">
                      <span class="font-semibold">Response Type:</span>
                      <.badge size={:xs}>
                        {resp[:response_type] || "-"}
                      </.badge>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Strategy:</span>
                      <.badge variant={strategy_badge_variant(resp[:strategy])} size={:xs}>
                        {(resp[:strategy] && step_label(resp.strategy)) || "-"}
                      </.badge>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Method:</span>
                      <span class="text-value text-ink">
                        {(resp[:method] && step_label(resp.method)) || "-"}
                      </span>
                    </div>
                    <%= if resp[:intent] do %>
                      <div class="flex justify-between">
                        <span class="font-semibold">Intent:</span>
                        <span class="text-value text-ink">{resp.intent}</span>
                      </div>
                    <% end %>
                    <%= if resp[:entities_count] && resp.entities_count > 0 do %>
                      <div class="flex justify-between">
                        <span class="font-semibold">Entities Used:</span>
                        <span class="text-value text-score-count">{resp.entities_count}</span>
                      </div>
                    <% end %>
                    <%= if resp[:reason] do %>
                      <div class="flex justify-between">
                        <span class="font-semibold">Reason:</span>
                        <span class="text-ink-muted">{resp.reason}</span>
                      </div>
                    <% end %>
                  </div>
                </.card_body>
              </.card>

<!-- Response Path Visualization - Detailed -->
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-md">
                    Response Generation Path
                  </div>

                  <%= if length(path_steps) > 0 do %>
                    <div class="space-y-space-sm">
                      <%= for step <- path_steps do %>
                        <% step_treatment = path_step_treatment(step[:status]) %>
                        <div class="relative pl-space-xl pb-space-sm">
                          <!-- Vertical line connector -->
                          <div class="absolute left-2 top-3 bottom-0 w-px bg-border-strong"></div>

                          <!-- Step indicator -->
                          <div class={[
                            "absolute left-0 top-1 size-4 rounded-pip flex items-center justify-center text-caption font-semibold",
                            step_treatment.indicator
                          ]}>
                            {step[:step]}
                          </div>

                          <!-- Step content -->
                          <div class="bg-surface-sunk rounded-sm p-space-sm">
                            <div class="flex items-center justify-between mb-space-xs">
                              <span class="font-semibold text-caption text-ink">
                                {step[:name]}
                              </span>
                              <.badge variant={step_treatment.badge} size={:xs}>
                                {step[:status]}
                              </.badge>
                            </div>
                            <div class="text-caption text-ink-muted">
                              {step[:detail]}
                            </div>

                            <!-- Handler details if present -->
                            <%= if step[:handlers_tried] do %>
                              <div class="mt-space-sm space-y-space-xs">
                                <%= for handler <- step.handlers_tried do %>
                                  <div class={[
                                    "flex items-center gap-space-sm text-caption p-space-xs rounded-sm",
                                    if handler[:selected] do
                                      "bg-resolved-wash border border-resolved-mark"
                                    else
                                      "bg-surface"
                                    end
                                  ]}>
                                    <%= if handler[:selected] do %>
                                      <.mark shape={:filled_diamond} class="size-2.5 text-resolved-mark" />
                                    <% else %>
                                      <%= if handler[:tried] do %>
                                        <.icon name="hero-x-circle" class="size-3 text-ink-muted" />
                                      <% else %>
                                        <.icon name="hero-minus-circle" class="size-3 text-ink-muted" />
                                      <% end %>
                                    <% end %>
                                    <span class={[
                                      "text-term",
                                      if(handler[:selected], do: "text-ink font-semibold", else: "text-ink-muted")
                                    ]}>
                                      {handler[:handler]}
                                    </span>
                                    <span class="text-ink-muted flex-1 truncate">
                                      {handler[:reason]}
                                    </span>
                                  </div>
                                <% end %>
                              </div>
                            <% end %>

                            <!-- Entities if present -->
                            <%= if step[:entities] && length(step.entities) > 0 do %>
                              <div class="mt-space-sm flex flex-wrap gap-space-xs">
                                <%= for entity <- step.entities do %>
                                  <span class="px-space-xs py-space-2xs bg-surface border border-border text-ink-muted rounded-sm text-caption">
                                    {entity[:type]}: {entity[:value]}
                                  </span>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <!-- Simple path visualization when detailed path not available -->
                    <div class="flex items-center gap-space-sm text-caption flex-wrap">
                      <span class="px-space-sm py-space-xs bg-surface-sunk text-ink rounded-sm">Input</span>
                      <.icon name="hero-arrow-right" class="size-3 text-ink-muted" />
                      <span class="px-space-sm py-space-xs bg-surface-sunk text-ink rounded-sm">Analysis</span>
                      <.icon name="hero-arrow-right" class="size-3 text-ink-muted" />
                      <span class="px-space-sm py-space-xs bg-surface-sunk text-ink-muted rounded-sm">
                        {resp[:response_type] || "Response"}
                      </span>
                    </div>
                  <% end %>
                </.card_body>
              </.card>

              <!-- Data Stores Accessed -->
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Data Stores Accessed
                  </div>
                  <div class="space-y-space-xs text-caption">
                    <% stores_accessed = get_stores_accessed(resp[:response_type]) %>
                    <%= for store <- stores_accessed do %>
                      <div class="flex items-center gap-space-sm p-space-xs bg-surface-sunk rounded-sm">
                        <.icon name="hero-circle-stack" class="size-3 text-ink-muted" />
                        <span class="text-ref text-ink">{store.name}</span>
                        <span class="text-ink-muted">{store.purpose}</span>
                      </div>
                    <% end %>
                    <%= if length(stores_accessed) == 0 do %>
                      <div class="text-ink-muted italic p-space-sm">
                        No data stores accessed
                      </div>
                    <% end %>
                  </div>
                </.card_body>
              </.card>
            </div>
          <% end %>

          <%= if active_tab == "raw" do %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Raw Analysis Data
                  </div>
                  <p class="text-caption text-ink-muted mb-space-md">
                    Full debug dump of all captured analysis data for this message.
                  </p>
                  <pre class="text-term bg-surface-sunk p-space-md rounded-sm overflow-x-auto whitespace-pre-wrap break-all text-ink">{inspect(dev, pretty: true, limit: :infinity, width: 60)}</pre>
                </.card_body>
              </.card>

              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Raw Processing Steps
                  </div>
                  <p class="text-caption text-ink-muted mb-space-md">
                    All progress events received during processing.
                  </p>
                  <pre class="text-term bg-surface-sunk p-space-md rounded-sm overflow-x-auto whitespace-pre-wrap break-all text-ink">{inspect(analysis_steps, pretty: true, limit: :infinity, width: 60)}</pre>
                </.card_body>
              </.card>
            </div>
          <% end %>

          <%= if active_tab == "beliefs" do %>
            <% all_beliefs = collect_all_beliefs(dev)
            all_statuses = collect_epistemic_statuses(dev)
            worst_status = worst_epistemic_status(all_statuses)
            contradiction_count = Enum.count(all_statuses, & &1 == :contradicted)
            verified_count = Enum.count(all_statuses, & &1 == :verified)
            uncertain_count = Enum.count(all_statuses, & &1 == :uncertain) %>
            <div class="space-y-space-md max-h-[600px] overflow-y-auto">
              <!-- Epistemic Summary -->
              <.card>
                <.card_body class="p-space-md">
                  <div class="text-caption font-semibold text-ink mb-space-sm">
                    Epistemic Summary
                  </div>
                  <div class="text-caption text-ink-muted space-y-space-sm">
                    <div class="flex justify-between items-center">
                      <span class="font-semibold">Overall Status:</span>
                      <.epistemic_status_label status={worst_status} />
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Beliefs Checked:</span>
                      <span class="text-value text-score-count">{length(all_beliefs)}</span>
                    </div>
                    <div class="grid grid-cols-3 gap-space-sm pt-space-xs">
                      <div class="text-center p-space-xs rounded-sm border bg-surface-sunk border-border-strong">
                        <div class="text-value-strong text-ink">{verified_count}</div>
                        <div class="text-caption text-ink-muted">Verified</div>
                      </div>
                      <div class="text-center p-space-xs rounded-sm border bg-ochre-wash border-ochre">
                        <div class="text-value-strong text-ochre">{contradiction_count}</div>
                        <div class="text-caption text-ink-muted inline-flex items-center gap-space-2xs">
                          <.icon name="hero-exclamation-triangle" class="size-3 shrink-0 text-ochre" /> Contradicted
                        </div>
                      </div>
                      <div class="text-center p-space-xs rounded-sm border bg-ochre-wash border-ochre">
                        <div class="text-value-strong text-ochre">{uncertain_count}</div>
                        <div class="text-caption text-ink-muted">Uncertain</div>
                      </div>
                    </div>
                  </div>
                </.card_body>
              </.card>

              <!-- Related Beliefs -->
              <%= if length(all_beliefs) > 0 do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="flex flex-wrap items-center justify-between gap-space-sm mb-space-sm">
                      <span class="text-caption font-semibold text-ink">Related Beliefs</span>
                      <.reach_badge reach={:shared} target="belief store" />
                    </div>
                    <div class="space-y-space-sm">
                      <%= for belief <- all_beliefs do %>
                        <% b_conf = belief[:confidence]
                        b_source = belief[:source]
                        b_status = belief[:_chunk_status] %>
                        <div class={[
                          "p-space-sm rounded-sm border text-caption",
                          epistemic_panel_class(b_status)
                        ]}>
                          <!-- Subject / Predicate / Object -->
                          <div class="flex items-center gap-space-xs mb-space-xs">
                            <span class="text-value-strong text-ink">
                              {belief[:subject]}
                            </span>
                            <span class="text-ink-muted">/</span>
                            <span class="text-value text-ink-muted">
                              {belief[:predicate]}
                            </span>
                            <span class="text-ink-muted">/</span>
                            <span class="text-value-strong text-ink">
                              {belief[:object]}
                            </span>
                          </div>

                          <!-- Confidence bar -->
                          <div class="flex items-center gap-space-sm mb-space-xs">
                            <span class="text-ink-muted w-16 shrink-0">Confidence:</span>
                            <.score_display value={b_conf} kind={:belief_confidence} form={:bar} class="min-w-0" />
                          </div>

                          <!-- Source + Authority + JTMS badges + Actions -->
                          <div class="flex flex-wrap items-center gap-space-sm">
                            <%= if belief[:source_authority] do %>
                              <.badge>
                                {belief[:source_authority]}
                                <span class="font-normal">· {authority_category(belief[:source_authority])}</span>
                              </.badge>
                            <% end %>
                            <%= if b_source do %>
                              <span class="px-space-xs py-space-2xs rounded-sm text-caption font-semibold bg-surface-sunk text-ink-muted">
                                {b_source}
                              </span>
                            <% end %>
                            <%= if belief[:node_id] do %>
                              <span class="px-space-xs py-space-2xs rounded-sm text-caption bg-surface-sunk text-ink-muted">
                                JTMS
                              </span>
                            <% end %>
                            <%= if b_status do %>
                              <.epistemic_status_label status={b_status} class="text-label" />
                            <% end %>

                            <!-- Inline action buttons -->
                            <%= if belief[:id] do %>
                              <div class="flex items-center gap-space-xs ml-auto">
                                <.icon_btn
                                  id={"belief-confirm-trigger-#{belief[:id]}"}
                                  size={:sm}
                                  phx-click="open_confirm"
                                  phx-value-id={"belief-confirm-#{belief[:id]}"}
                                  title="Confirm belief"
                                >
                                  <.icon name="hero-check-circle" class="size-3.5" />
                                </.icon_btn>
                                <.icon_btn
                                  id={"belief-retract-trigger-#{belief[:id]}"}
                                  size={:sm}
                                  phx-click="open_confirm"
                                  phx-value-id={"belief-retract-#{belief[:id]}"}
                                  title="Retract belief"
                                >
                                  <.icon name="hero-x-circle" class="size-3.5" />
                                </.icon_btn>
                              </div>
                            <% end %>
                          </div>

                          <%= if belief[:id] do %>
                            <% belief_target = "belief #{String.slice(to_string(belief[:id]), 0, 8)}" %>
                            <.execute_confirm
                              id={"belief-confirm-#{belief[:id]}"}
                              open={@open_confirm == "belief-confirm-#{belief[:id]}"}
                              reach={:shared}
                              verb="Confirm"
                              target={belief_target}
                              consequence="Raises this belief's confidence by 0.1, to at most 1.0, in the belief store every session reads, and, when it has a source authority, counts the confirmation toward that authority's credibility."
                              on_confirm={JS.push("inspector_confirm_belief", value: %{belief_id: belief[:id]})}
                              on_cancel="close_confirm"
                              trigger_id={"belief-confirm-trigger-#{belief[:id]}"}
                              error={@confirm_error}
                              class="mt-space-sm"
                            />
                            <.execute_confirm
                              id={"belief-retract-#{belief[:id]}"}
                              open={@open_confirm == "belief-retract-#{belief[:id]}"}
                              reach={:shared}
                              verb="Retract"
                              target={belief_target}
                              consequence="Retracts this belief from the belief store every session reads and marks it retracted in Atlas, and, when it has a source authority, counts the retraction against that authority's credibility."
                              on_confirm={JS.push("inspector_retract_belief", value: %{belief_id: belief[:id]})}
                              on_cancel="close_confirm"
                              trigger_id={"belief-retract-trigger-#{belief[:id]}"}
                              error={@confirm_error}
                              class="mt-space-sm"
                            />
                          <% end %>
                        </div>
                      <% end %>
                    </div>

                    <!-- "Add guided belief" mini-form -->
                    <div class="mt-space-md pt-space-md border-t border-border space-y-space-sm">
                      <.btn
                        id="add-belief"
                        variant={:ghost}
                        size={:xs}
                        reach={:shared}
                        target="belief store"
                        phx-click="show_correction_form"
                      >
                        <.icon name="hero-plus" class="size-3" />
                        <span>Add guided belief</span>
                      </.btn>
                      <.execute_confirm
                        id="add-belief-confirm"
                        open={@inspector_correction_form != nil}
                        reach={:shared}
                        verb="Add belief"
                        target="belief store"
                        consequence="Adds this belief, with a JTMS node, to the belief store every session reads, and persists it to Atlas."
                        on_confirm="submit_correction_belief"
                        on_cancel="cancel_correction_form"
                        trigger_id="add-belief"
                        error={@correction_error}
                      >
                        <:fields>
                        <div class="space-y-space-sm">
                          <div class="grid grid-cols-3 gap-space-sm">
                            <select name="subject" class="w-full h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink">
                              <option value="self" selected={@inspector_correction_form["subject"] == "self"}>self</option>
                              <option value="user" selected={@inspector_correction_form["subject"] == "user"}>user</option>
                              <option value="world" selected={@inspector_correction_form["subject"] == "world"}>world</option>
                            </select>
                            <input
                              type="text"
                              name="predicate"
                              value={@inspector_correction_form["predicate"]}
                              placeholder="predicate"
                              class="w-full h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink placeholder:text-ink-muted"
                              required
                            />
                            <input
                              type="text"
                              name="object"
                              value={@inspector_correction_form["object"]}
                              placeholder="value"
                              class="w-full h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink placeholder:text-ink-muted"
                              required
                            />
                          </div>
                          <div>
                            <select name="authority" class="w-full min-w-0 h-control-sm px-space-sm rounded-sm border border-border-strong bg-surface-sunk text-body-dense text-ink">
                              <%= if @authority_profiles != [] do %>
                                <%= for {category, profiles} <- group_authority_profiles(@authority_profiles) do %>
                                  <optgroup label={String.capitalize(category)}>
                                    <%= for p <- profiles do %>
                                      <option value={p.key} selected={to_string(p.key) == @inspector_correction_form["authority"]}>
                                        {p.profile.label} ({Float.round(p.profile.initial_confidence * 100, 0)}%)
                                      </option>
                                    <% end %>
                                  </optgroup>
                                <% end %>
                              <% else %>
                                <option value="mentor" selected>Mentor</option>
                                <option value="stranger">Stranger</option>
                              <% end %>
                            </select>
                          </div>
                        </div>
                        </:fields>
                      </.execute_confirm>
                    </div>
                  </.card_body>
                </.card>
              <% else %>
                <div class="text-center text-ink-muted py-space-xl">
                  <.icon name="hero-eye-slash" class="size-8 mx-auto mb-space-sm" />
                  <p class="text-caption">No beliefs were checked for this message</p>
                  <p class="text-caption mt-space-xs">
                    Beliefs are checked for assertive statements about verifiable facts
                  </p>
                </div>
              <% end %>

              <!-- Per-Chunk Breakdown -->
              <% chunks_with_beliefs = Enum.filter(
                Enum.sort_by(Map.get(dev, :chunks, %{}), fn {i, _} -> i end),
                fn {_, chunk} -> length(chunk[:related_beliefs] || []) > 0 end
              ) %>
              <%= if length(chunks_with_beliefs) > 0 do %>
                <.card>
                  <.card_body class="p-space-md">
                    <div class="text-caption font-semibold text-ink mb-space-sm">
                      Per-Chunk Verification
                    </div>
                    <div class="space-y-space-sm">
                      <%= for {idx, chunk} <- chunks_with_beliefs do %>
                        <div class="p-space-sm bg-surface-sunk rounded-sm">
                          <div class="flex items-center justify-between mb-space-xs">
                            <span class="font-semibold text-caption text-ink">Chunk {idx + 1}</span>
                            <.epistemic_status_label status={chunk[:epistemic_status]} class="text-caption" />
                          </div>
                          <%= if chunk[:chunk_text] do %>
                            <div class="text-caption text-ink-muted mb-space-xs truncate">
                              "{chunk.chunk_text}"
                            </div>
                          <% end %>
                          <div class="text-caption text-ink-muted">
                            <span class="text-value text-score-count">{length(chunk[:related_beliefs] || [])}</span> belief(s) checked
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </.card_body>
                </.card>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- No message selected -->
        <div class="p-space-2xl text-center text-ink-muted">
          <.icon name="hero-cursor-arrow-rays" class="size-10 mx-auto mb-space-md" />
          <p class="text-body-dense">Select a processing pill to inspect details</p>
        </div>
      <% end %>

<!-- Knowledge Panel (when toggled) -->
      <%= if @show_knowledge do %>
        <div class="border-t border-border">
          <div class="p-space-lg">
            <.section_header icon="hero-light-bulb" class="mb-space-md">
              Learned Knowledge
            </.section_header>

            <div class="space-y-space-md max-h-64 overflow-y-auto text-caption">
              <%= if map_size(@knowledge) == 0 do %>
                <div class="text-ink-muted italic">
                  No knowledge learned yet
                </div>
              <% else %>
                <!-- People -->
                <%= if Map.has_key?(@knowledge, "people") && map_size(@knowledge["people"]) > 0 do %>
                  <div>
                    <div class="font-semibold text-ink-muted mb-space-xs">
                      People
                    </div>
                    <%= for {name, person} <- @knowledge["people"] do %>
                      <div class="text-ink ml-space-sm mb-space-xs">
                        <strong>{name}</strong>
                        <%= if person["age"] do %>
                          ({person["age"]} years old)
                        <% end %>
                        <%= if person["occupation"] do %>
                          - {person["occupation"]}
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>

<!-- Pets -->
                <%= if Map.has_key?(@knowledge, "pets") && map_size(@knowledge["pets"]) > 0 do %>
                  <div>
                    <div class="font-semibold text-ink-muted mb-space-xs">Pets</div>
                    <%= for {name, pet} <- @knowledge["pets"] do %>
                      <div class="text-ink ml-space-sm mb-space-xs">
                        <strong>{name}</strong>
                        <%= if pet["species"] do %>
                          - {pet["species"]}
                        <% end %>
                        <%= if pet["breed"] do %>
                          ({pet["breed"]})
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>

<!-- Devices -->
                <%= if Map.has_key?(@knowledge, "devices") && map_size(@knowledge["devices"]) > 0 do %>
                  <div>
                    <div class="font-semibold text-ink-muted mb-space-xs">
                      Devices
                    </div>
                    <%= for {name, device} <- @knowledge["devices"] do %>
                      <div class="text-ink ml-space-sm mb-space-xs">
                        <strong>{name}</strong>
                        <%= if device["type"] do %>
                          - {device["type"]}
                        <% end %>
                        <%= if device["location"] do %>
                          in {device["location"]}
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>

<!-- Relationships -->
                <%= if Map.has_key?(@knowledge, "relationships") && length(@knowledge["relationships"]) > 0 do %>
                  <div>
                    <div class="font-semibold text-ink-muted mb-space-xs">
                      Relationships
                    </div>
                    <%= for rel <- @knowledge["relationships"] do %>
                      <div class="text-ink ml-space-sm mb-space-xs">
                        <strong>{rel["subject"]}</strong> {rel["relation"]}
                        <strong>{rel["object"]}</strong>
                      </div>
                    <% end %>
                  </div>
                <% end %>

<!-- User Facts -->
                <%= if Map.has_key?(@knowledge, "user_facts") && length(@knowledge["user_facts"]) > 0 do %>
                  <div>
                    <div class="font-semibold text-ink-muted mb-space-xs">
                      User Memory
                    </div>
                    <%= for user <- @knowledge["user_facts"] do %>
                      <div class="ml-space-sm mb-space-sm p-space-sm bg-surface-sunk rounded-sm">
                        <div class="text-ref text-ink mb-space-xs">
                          User: {String.slice(user["user_id"] || "unknown", 0, 12)}...
                        </div>
                        <%= if user["facts"] && length(user["facts"]) > 0 do %>
                          <%= for fact <- user["facts"] do %>
                            <div class="text-ink ml-space-sm">
                              <strong>{fact["key"]}</strong>: {fact["value"]}
                            </div>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </aside>

<!-- Mobile drawer backdrop -->
  <div
    id="drawer-backdrop"
    class="hidden fixed inset-0 bg-ground/80 z-20 lg:hidden"
    phx-click={
      JS.hide(to: "#left-drawer")
      |> JS.hide(to: "#right-drawer")
      |> JS.hide(to: "#drawer-backdrop")
    }
  >
  </div>
</div>
