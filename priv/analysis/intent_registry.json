{
  "weather.query": {
    "description": "Weather information request",
    "domain": "weather",
    "category": "directive",
    "speech_act": "request_information",
    "required": ["location"],
    "optional": ["date", "time", "unit-temperature"],
    "defaults": {
      "date": "today"
    },
    "entity_mappings": {
      "location": ["location", "room", "city"],
      "date": ["date", "relative_date", "sys-date"],
      "time": ["time", "sys-time"],
      "unit-temperature": ["unit-temperature"]
    },
    "clarification_templates": {
      "location": "What location would you like the weather for?"
    }
  },
