<div class="min-h-screen bg-gradient-to-br from-base-300 via-base-200 to-base-300">
  <!-- Header -->
  <header class="bg-base-100/80 backdrop-blur-lg border-b border-base-300/50 shadow-lg sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
          <.link navigate={~p"/chat"}>
            <.icon_btn variant={:outline} title="Back to Chat">
              <.icon name="hero-arrow-left" class="size-5" />
            </.icon_btn>
          </.link>
          <div>
            <h1 class="text-2xl font-bold flex items-center gap-3 text-base-content">
              <div class="p-2 rounded-xl bg-gradient-to-br from-primary to-primary/60 text-primary-content shadow-lg shadow-primary/20">
                <.icon name="hero-chart-bar-square" class="size-6" />
              </div>
              Operations Dashboard
            </h1>
            <p class="text-sm text-base-content/60 mt-1">
              Real-time system monitoring and health indicators
            </p>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="text-xs text-base-content/50 bg-base-200 px-3 py-1.5 rounded-full">
            Updated: {format_datetime(@last_updated)}
          </div>
          <.toggle
            checked={@auto_refresh}
            label="Auto-refresh"
            size={:sm}
            phx-click="toggle_auto_refresh"
          />
          <.btn variant={:outline} size={:sm} phx-click="manual_refresh">
            <.icon name="hero-arrow-path" class="size-4" /> Refresh
          </.btn>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
    <!-- Health Overview Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Health Score Card -->
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-base-100 to-base-100/80 border border-base-300/50 shadow-xl shadow-base-300/20 p-6">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/10 to-transparent rounded-full -translate-y-1/2 translate-x-1/2">
        </div>
        <div class="relative">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-base-content/60 uppercase tracking-wider">
                Health Score
              </p>
              <p class={[
                "text-4xl font-bold mt-2 tracking-tight",
                health_status_color(@health_indicators.health_status)
              ]}>
                {@health_indicators.health_score}%
              </p>
            </div>
            <.circular_progress
              value={@health_indicators.health_score}
              variant={health_variant(@health_indicators.health_status)}
              size={:lg}
            >
              <.icon name="hero-heart-solid" class="size-6" />
            </.circular_progress>
          </div>
          <div class="mt-4 pt-4 border-t border-base-300/50">
            <.badge variant={health_variant(@health_indicators.health_status)} size={:sm}>
              <.icon name="hero-check-circle" class="size-3 mr-1" />
              {@health_indicators.health_status |> to_string() |> String.capitalize()}
            </.badge>
          </div>
        </div>
      </div>
      
<!-- GenServers Card -->
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-base-100 to-base-100/80 border border-base-300/50 shadow-xl shadow-base-300/20 p-6">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-success/10 to-transparent rounded-full -translate-y-1/2 translate-x-1/2">
        </div>
        <div class="relative">
          <p class="text-sm font-medium text-base-content/60 uppercase tracking-wider">
            GenServers
          </p>
          <div class="flex items-end gap-2 mt-2">
            <span class="text-4xl font-bold text-base-content tracking-tight">
              {@health_indicators.genservers_running}
            </span>
            <span class="text-xl text-base-content/40 mb-1">
              / {@health_indicators.genservers_total}
            </span>
          </div>
          <div class="mt-4 pt-4 border-t border-base-300/50 flex items-center justify-between">
            <span class="text-sm text-base-content/60">Running processes</span>
            <div class="p-2 rounded-xl bg-success/10">
              <.icon name="hero-server-stack" class="size-5 text-success" />
            </div>
          </div>
        </div>
      </div>
      
<!-- Uptime Card -->
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-base-100 to-base-100/80 border border-base-300/50 shadow-xl shadow-base-300/20 p-6">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-info/10 to-transparent rounded-full -translate-y-1/2 translate-x-1/2">
        </div>
        <div class="relative">
          <p class="text-sm font-medium text-base-content/60 uppercase tracking-wider">Uptime</p>
          <p class="text-4xl font-bold text-base-content mt-2 tracking-tight">
            {format_uptime(@health_indicators.uptime_seconds)}
          </p>
          <div class="mt-4 pt-4 border-t border-base-300/50 flex items-center justify-between">
            <span class="text-sm text-base-content/60">System running time</span>
            <div class="p-2 rounded-xl bg-info/10">
              <.icon name="hero-clock" class="size-5 text-info" />
            </div>
          </div>
        </div>
      </div>
      
<!-- Supervisor Card -->
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-base-100 to-base-100/80 border border-base-300/50 shadow-xl shadow-base-300/20 p-6">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/10 to-transparent rounded-full -translate-y-1/2 translate-x-1/2">
        </div>
        <div class="relative">
          <p class="text-sm font-medium text-base-content/60 uppercase tracking-wider">
            Supervisor
          </p>
          <p class="text-4xl font-bold text-base-content mt-2 tracking-tight">
            {@health_indicators.supervisor.active}
          </p>
          <div class="mt-4 pt-4 border-t border-base-300/50 flex items-center justify-between">
            <span class="text-sm text-base-content/60">
              {@health_indicators.supervisor.workers} workers
            </span>
            <div class="p-2 rounded-xl bg-primary/10">
              <.icon name="hero-cube-transparent" class="size-5 text-primary" />
            </div>
          </div>
        </div>
      </div>
    </section>
    
<!-- Performance Metrics -->
    <section class="rounded-2xl bg-base-100 border border-base-300/50 shadow-xl shadow-base-300/20 overflow-hidden">
      <div class="p-6 border-b border-base-300/50 bg-gradient-to-r from-base-100 to-base-200/30">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-gradient-to-br from-warning/20 to-warning/5">
            <.icon name="hero-chart-bar" class="size-5 text-warning" />
          </div>
          <div>
            <h2 class="text-lg font-bold text-base-content">Performance Metrics</h2>
            <p class="text-sm text-base-content/60">Response times and throughput</p>
          </div>
        </div>
      </div>

      <div class="p-6">
        <%= if map_size(@performance_metrics) == 0 or not Enum.any?(@performance_metrics, fn {_, v} -> is_map(v) and Map.has_key?(v, :avg_ms) end) do %>
          <div class="text-center py-12">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-base-200 mb-4">
              <.icon name="hero-chart-bar" class="size-8 text-base-content/30" />
            </div>
            <p class="text-base-content/60 font-medium">No performance data available yet</p>
            <p class="text-sm text-base-content/40 mt-1">
              Metrics will appear after processing some requests
            </p>
          </div>
        <% else %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
            <%= for {metric_name, data} <- @performance_metrics do %>
              <%= if is_map(data) and Map.has_key?(data, :avg_ms) do %>
                <div class="group rounded-xl bg-gradient-to-br from-base-200/80 to-base-200/40 border border-base-300/30 p-4 hover:border-primary/30 hover:shadow-lg transition-all duration-200">
                  <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-3">
                    {metric_name |> to_string() |> String.replace("_", " ")}
                  </div>
                  <div class="space-y-2">
                    <div class="flex justify-between items-center">
                      <span class="text-xs text-base-content/60">Avg</span>
                      <span class="font-mono font-bold text-base-content">
                        {format_ms(data.avg_ms)}
                      </span>
                    </div>
                    <div class="flex justify-between items-center">
                      <span class="text-xs text-base-content/60">P95</span>
                      <span class="font-mono text-sm text-base-content/80">
                        {format_ms(data[:p95_ms] || data.avg_ms)}
                      </span>
                    </div>
                    <div class="h-px bg-base-300/50 my-2"></div>
                    <div class="flex justify-between items-center text-xs">
                      <span class="text-base-content/50">Min/Max</span>
                      <span class="font-mono text-base-content/60">
                        {format_ms(data.min_ms)} / {format_ms(data.max_ms)}
                      </span>
                    </div>
                  </div>
                  <div class="mt-3 pt-3 border-t border-base-300/30 flex justify-between text-xs">
                    <span class="text-base-content/40">{data.count} calls</span>
                    <span class="text-primary/80">{format_rate(data[:rate_per_minute])}</span>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
    
<!-- GenServer Status -->
    <section class="space-y-4">
      <div class="flex items-center gap-3 px-2">
        <div class="p-2 rounded-xl bg-gradient-to-br from-secondary/20 to-secondary/5">
          <.icon name="hero-server-stack" class="size-5 text-secondary" />
        </div>
        <div>
          <h2 class="text-lg font-bold text-base-content">GenServer Status</h2>
          <p class="text-sm text-base-content/60">Process health by category</p>
        </div>
      </div>

      <div class="grid gap-4">
        <%= for category <- [:core, :epistemic, :analysis, :ml, :storage] do %>
          <div class="rounded-2xl bg-base-100 border border-base-300/50 shadow-lg shadow-base-300/10 overflow-hidden">
            <button
              type="button"
              class="w-full p-5 text-left hover:bg-base-200/30 transition-colors duration-200"
              phx-click="toggle_category"
              phx-value-category={category}
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class={[
                    "p-2.5 rounded-xl",
                    category_bg_class(category)
                  ]}>
                    <.icon
                      name={category_icon(category)}
                      class={["size-5", category_text_class(category)]}
                    />
                  </div>
                  <div>
                    <h3 class="font-semibold text-base-content text-lg">
                      {category_label(category)}
                    </h3>
                    <p class="text-sm text-base-content/50">
                      {count_running_in_category(@genserver_status.categories, category)} of {count_total_in_category(
                        @genserver_status.categories,
                        category
                      )} processes running
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="hidden sm:flex items-center gap-1.5">
                    <% running = count_running_in_category(@genserver_status.categories, category) %>
                    <% total = count_total_in_category(@genserver_status.categories, category) %>
                    <%= for i <- 1..total do %>
                      <div class={[
                        "w-2 h-2 rounded-full",
                        if(i <= running, do: "bg-success", else: "bg-base-300")
                      ]}>
                      </div>
                    <% end %>
                  </div>
                  <.icon
                    name={
                      if MapSet.member?(@expanded_categories, category),
                        do: "hero-chevron-up",
                        else: "hero-chevron-down"
                    }
                    class="size-5 text-base-content/40"
                  />
                </div>
              </div>
            </button>

            <%= if MapSet.member?(@expanded_categories, category) do %>
              <div class="px-5 pb-5 border-t border-base-300/30 pt-4">
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  <%= for {_module, status} <- category_servers(@genserver_status.categories, category) do %>
                    <div class="rounded-xl bg-gradient-to-br from-base-200/60 to-base-200/30 border border-base-300/30 p-4 hover:border-base-300 transition-colors">
                      <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2.5 min-w-0">
                          <.status_dot
                            status={status.status}
                            pulse={
                              status.status in [:initializing, :building_vocabulary, :loading]
                            }
                          />
                          <span class="font-semibold text-sm text-base-content truncate">
                            {status.name}
                          </span>
                        </div>
                        <.badge
                          variant={status_badge_variant(status.status)}
                          size={:xs}
                        >
                          {status.label}
                        </.badge>
                      </div>

                      <div class="grid grid-cols-2 gap-3 text-xs">
                        <div class="flex items-center gap-2 text-base-content/60">
                          <.icon name="hero-cpu-chip" class="size-3.5" />
                          <span>{format_bytes(status.memory_bytes)}</span>
                        </div>
                        <div class="flex items-center gap-2 text-base-content/60">
                          <.icon name="hero-queue-list" class="size-3.5" />
                          <span>Queue: {status.message_queue_len || 0}</span>
                        </div>
                      </div>

                      <%= if status.stats && is_map(status.stats) && map_size(status.stats) > 0 do %>
                        <div class="mt-3 pt-3 border-t border-base-300/30 space-y-1.5">
                          <%= for {key, value} <- Enum.take(status.stats, 3) do %>
                            <div class="flex justify-between text-xs">
                              <span class="text-base-content/50">
                                {key |> to_string() |> String.replace("_", " ")}
                              </span>
                              <span class="font-mono text-base-content/70">
                                {format_stat_value(value)}
                              </span>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
    
<!-- Subprocess Supervisor -->
    <section class="rounded-2xl bg-base-100 border border-base-300/50 shadow-xl shadow-base-300/20 overflow-hidden">
      <div class="p-6 border-b border-base-300/50 bg-gradient-to-r from-base-100 to-base-200/30">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-gradient-to-br from-accent/20 to-accent/5">
            <.icon name="hero-rectangle-group" class="size-5 text-accent" />
          </div>
          <div>
            <h2 class="text-lg font-bold text-base-content">Subprocess Supervisor</h2>
            <p class="text-sm text-base-content/60">Child process overview</p>
          </div>
        </div>
      </div>

      <div class="p-6">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="text-center p-5 rounded-xl bg-gradient-to-br from-base-200/80 to-base-200/40 border border-base-300/30">
            <div class="text-3xl font-bold text-base-content">
              {@genserver_status.subprocess_supervisor.active_children}
            </div>
            <div class="text-sm text-base-content/60 mt-1">Active Children</div>
          </div>
          <div class="text-center p-5 rounded-xl bg-gradient-to-br from-base-200/80 to-base-200/40 border border-base-300/30">
            <div class="text-3xl font-bold text-base-content">
              {@genserver_status.subprocess_supervisor.workers}
            </div>
            <div class="text-sm text-base-content/60 mt-1">Workers</div>
          </div>
          <div class="text-center p-5 rounded-xl bg-gradient-to-br from-base-200/80 to-base-200/40 border border-base-300/30">
            <div class="text-3xl font-bold text-base-content">
              {@genserver_status.subprocess_supervisor.supervisors}
            </div>
            <div class="text-sm text-base-content/60 mt-1">Supervisors</div>
          </div>
          <div class="text-center p-5 rounded-xl bg-gradient-to-br from-base-200/80 to-base-200/40 border border-base-300/30">
            <div class="text-3xl font-bold text-base-content">
              {@genserver_status.subprocess_supervisor.specs}
            </div>
            <div class="text-sm text-base-content/60 mt-1">Specs</div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-center gap-3 text-sm">
          <.status_dot status={
            if @genserver_status.subprocess_supervisor.running, do: :ready, else: :not_started
          } />
          <span class="text-base-content/60">
            <%= if @genserver_status.subprocess_supervisor.running do %>
              Running (PID: {inspect(@genserver_status.subprocess_supervisor.pid)})
            <% else %>
              Not running
            <% end %>
          </span>
        </div>
      </div>
    </section>
    
<!-- Footer -->
    <footer class="text-center py-6">
      <p class="text-xs text-base-content/30">
        Check duration: {@genserver_status.check_duration_ms}ms
      </p>
    </footer>
  </main>
</div>
