<div class="flex h-screen bg-base-200" phx-window-keydown="close_add_modal" phx-key="Escape">
  <!-- Sidebar -->
  <aside class="w-64 bg-base-100 border-r border-base-300 flex flex-col shadow-lg">
    <!-- Sidebar Header -->
    <div class="p-4 border-b border-base-300 bg-gradient-to-b from-base-100 to-base-100/95">
      <div class="flex items-center justify-between">
        <h1 class="text-lg font-bold tracking-tight">Entities</h1>
        <.link
          navigate={~p"/chat"}
          class="btn btn-ghost btn-sm btn-square hover:bg-base-200 transition-colors"
          title="Back to Chat"
        >
          <.icon name="hero-arrow-left" class="w-4 h-4" />
        </.link>
      </div>
      <div class="mt-2 flex gap-2 text-xs text-base-content/60">
        <span class="badge badge-sm badge-ghost">{@stats[:entities] || 0} total</span>
        <span class="badge badge-sm badge-ghost">{length(@entity_types)} types</span>
      </div>
    </div>
    
<!-- Search -->
    <div class="p-3 border-b border-base-300">
      <div class="relative group">
        <.icon
          name="hero-magnifying-glass"
          class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40 group-focus-within:text-primary transition-colors"
        />
        <input
          type="text"
          placeholder="Search all entities..."
          class="input input-sm input-bordered w-full pl-9 focus:input-primary transition-all"
          value={@search_query}
          phx-keyup="search"
          phx-value-query={@search_query}
          name="query"
          phx-debounce="150"
        />
        <%= if @search_query != "" do %>
          <button
            phx-click="clear_search"
            class="absolute right-2 top-1/2 -translate-y-1/2 text-base-content/40 hover:text-base-content transition-colors"
          >
            <.icon name="hero-x-mark" class="w-4 h-4" />
          </button>
        <% end %>
      </div>
      <%= if length(@search_results) > 0 do %>
        <div class="mt-2 max-h-40 overflow-y-auto rounded-lg border border-base-300 bg-base-100 shadow-sm">
          <%= for {key, info} <- Enum.take(@search_results, 10) do %>
            <div class="flex items-center justify-between px-3 py-2 hover:bg-primary/5 text-sm border-b border-base-200 last:border-b-0 cursor-pointer transition-colors">
              <span class="truncate flex-1 font-medium">{key}</span>
              <span class="badge badge-xs badge-ghost ml-2">
                {info[:entity_type] || info[:type]}
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= if @search_query != "" and length(@search_results) == 0 do %>
        <div class="text-xs text-base-content/50 mt-2 text-center py-2">No results found</div>
      <% end %>
    </div>
    
<!-- Entity Types -->
    <div class="flex-1 overflow-y-auto p-2">
      <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wider px-2 py-2">
        Entity Types
      </div>
      <nav class="space-y-0.5">
        <%= for type <- @entity_types do %>
          <button
            phx-click="select_type"
            phx-value-type={type}
            class={[
              "w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-all duration-150",
              if(@selected_type == type,
                do: "bg-primary text-primary-content font-medium shadow-sm",
                else: "text-base-content hover:bg-base-200 active:scale-[0.98]"
              )
            ]}
          >
            <.icon name={icon_for_type(type)} class="w-4 h-4 flex-shrink-0" />
            <span class="flex-1 text-left truncate">{String.capitalize(type)}</span>
            <%= if @selected_type == type do %>
              <span class="text-xs px-1.5 py-0.5 rounded-md bg-primary-content/20 font-normal">
                {@total_entries}
              </span>
            <% end %>
          </button>
        <% end %>
      </nav>
    </div>
    
<!-- Sidebar Footer -->
    <div class="p-3 border-t border-base-300 bg-base-100 space-y-2">
      <button
        phx-click="refresh"
        class="btn btn-ghost btn-sm w-full gap-2 hover:bg-base-200 active:scale-[0.98] transition-all"
      >
        <.icon name="hero-arrow-path" class="w-4 h-4 phx-click-loading:animate-spin" />
        <span class="phx-click-loading:opacity-50">Refresh</span>
      </button>

      <div class="dropdown dropdown-top w-full">
        <div
          tabindex="0"
          role="button"
          class="btn btn-ghost btn-sm w-full gap-2 hover:bg-base-200"
        >
          <.icon name="hero-trash" class="w-4 h-4" />
          <span>Clear Data</span>
          <.icon name="hero-chevron-up" class="w-3 h-3 ml-auto" />
        </div>
        <ul
          tabindex="0"
          class="dropdown-content z-10 menu p-2 shadow-lg bg-base-100 rounded-box w-56 mb-2 border border-base-300"
        >
          <li>
            <button
              phx-click="clear_type"
              class="text-warning hover:bg-warning/10"
              data-confirm={"Clear all #{@selected_type} entries?"}
            >
              <.icon name="hero-folder-minus" class="w-4 h-4" /> Clear {@selected_type} type
            </button>
          </li>
          <li>
            <button
              phx-click="clear_admin"
              class="text-warning hover:bg-warning/10"
              data-confirm="Clear all admin-added entries?"
            >
              <.icon name="hero-user-minus" class="w-4 h-4" /> Clear admin entries
            </button>
          </li>
          <li class="border-t border-base-200 mt-1 pt-1">
            <button
              phx-click="reload_data"
              class="text-error hover:bg-error/10"
              data-confirm="Clear everything and reload from data files? This cannot be undone."
            >
              <.icon name="hero-arrow-path" class="w-4 h-4" /> Reload from files
            </button>
          </li>
        </ul>
      </div>
    </div>
  </aside>
  
<!-- Main Content -->
  <main class="flex-1 flex flex-col overflow-hidden">
    <!-- Header -->
    <header class="bg-base-100 border-b border-base-300 px-6 py-4 shadow-sm">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="p-2.5 rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 ring-1 ring-primary/10">
            <.icon name={icon_for_type(@selected_type)} class="w-6 h-6 text-primary" />
          </div>
          <div>
            <h2 class="text-xl font-semibold tracking-tight">
              {String.capitalize(@selected_type)} Entities
            </h2>
            <p class="text-sm text-base-content/60">
              <span class="font-medium text-base-content/80">{@total_entries}</span>
              entries
              <%= if @total_pages > 1 do %>
                <span class="mx-1.5 text-base-content/30">·</span>
                Page <span class="font-medium text-base-content/80">{@page}</span>
                of {@total_pages}
              <% end %>
            </p>
          </div>
        </div>
        <button
          phx-click="open_add_modal"
          class="btn btn-primary btn-sm gap-2 shadow-sm hover:shadow-md transition-shadow"
        >
          <.icon name="hero-plus" class="w-4 h-4" /> Add Entry
        </button>
      </div>
    </header>
    
<!-- Table Container -->
    <div class="flex-1 overflow-auto p-6">
      <div class="bg-base-100 rounded-xl shadow-sm border border-base-300 overflow-hidden">
        <%= if length(@entries) == 0 and @total_entries == 0 do %>
          <!-- Empty State -->
          <div class="text-center py-20 px-6">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-base-200/50 mb-5 ring-1 ring-base-300">
              <.icon name="hero-inbox" class="w-10 h-10 text-base-content/20" />
            </div>
            <p class="text-base-content/70 font-semibold text-lg">
              No {String.downcase(@selected_type)} entities
            </p>
            <p class="text-sm text-base-content/50 mt-2 max-w-xs mx-auto">
              Get started by adding your first {String.downcase(@selected_type)} entry
            </p>
            <button phx-click="open_add_modal" class="btn btn-primary btn-sm mt-6 gap-2">
              <.icon name="hero-plus" class="w-4 h-4" /> Add Entry
            </button>
          </div>
        <% else %>
          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="table w-full">
              <thead>
                <tr class="border-b-2 border-base-200">
                  <th class="bg-base-50/50 text-base-content/70 font-semibold">
                    <button
                      phx-click="sort"
                      phx-value-column="name"
                      class={[
                        "flex items-center gap-1.5 hover:text-primary transition-colors",
                        if(@sort_by == :name, do: "text-primary", else: "")
                      ]}
                    >
                      Name
                      <%= if sort_indicator(:name, @sort_by, @sort_dir) do %>
                        <.icon name={sort_indicator(:name, @sort_by, @sort_dir)} class="w-3 h-3" />
                      <% else %>
                        <.icon name="hero-chevron-up-down" class="w-3 h-3 opacity-30" />
                      <% end %>
                    </button>
                  </th>
                  <th class="bg-base-50/50 text-base-content/70 font-semibold w-28">
                    <button
                      phx-click="sort"
                      phx-value-column="source"
                      class={[
                        "flex items-center gap-1.5 hover:text-primary transition-colors",
                        if(@sort_by == :source, do: "text-primary", else: "")
                      ]}
                    >
                      Source
                      <%= if sort_indicator(:source, @sort_by, @sort_dir) do %>
                        <.icon
                          name={sort_indicator(:source, @sort_by, @sort_dir)}
                          class="w-3 h-3"
                        />
                      <% else %>
                        <.icon name="hero-chevron-up-down" class="w-3 h-3 opacity-30" />
                      <% end %>
                    </button>
                  </th>
                  <th class="bg-base-50/50 text-base-content/70 font-semibold">Details</th>
                  <th class="bg-base-50/50 w-12"></th>
                </tr>
              </thead>
              <tbody>
                <%= for {key, info} <- @entries do %>
                  <tr class="hover:bg-primary/[0.02] border-b border-base-200/70 last:border-b-0 transition-colors group">
                    <td class="font-medium text-base-content/90">
                      {info[:original_name] || info[:value] || key}
                    </td>
                    <td>
                      <span class={["badge badge-sm", source_badge_class(info[:source])]}>
                        {info[:source] || "data"}
                      </span>
                    </td>
                    <td class="text-sm text-base-content/50">
                      <%= cond do %>
                        <% info[:country] -> %>
                          <span class="text-base-content/70">{info[:country]}</span>{if info[
                                                                                          :region
                                                                                        ],
                                                                                        do:
                                                                                          ", #{info[:region]}"}
                        <% info[:population] -> %>
                          <span class="text-base-content/50">Pop:</span>
                          <span class="font-medium text-base-content/70">
                            {format_number(info[:population])}
                          </span>
                        <% true -> %>
                          <span class="text-base-content/20">—</span>
                      <% end %>
                    </td>
                    <td>
                      <%= if info[:source] == :admin do %>
                        <button
                          phx-click="remove_entry"
                          phx-value-name={key}
                          class="btn btn-ghost btn-xs btn-square text-error/70 hover:text-error hover:bg-error/10 opacity-0 group-hover:opacity-100 transition-all"
                          data-confirm="Remove this entry?"
                        >
                          <.icon name="hero-trash" class="w-4 h-4" />
                        </button>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
<!-- Pagination -->
          <%= if @total_pages > 1 do %>
            <div class="flex items-center justify-between px-4 py-3 border-t border-base-300">
              <div class="flex items-center gap-2 text-sm text-base-content/60">
                <span>Show</span>
                <select
                  class="select select-xs select-bordered"
                  phx-change="change_page_size"
                  name="size"
                >
                  <%= for size <- @page_size_options do %>
                    <option value={size} selected={@page_size == size}>{size}</option>
                  <% end %>
                </select>
                <span>per page</span>
              </div>

              <div class="flex items-center gap-1">
                <button
                  phx-click="change_page"
                  phx-value-page={@page - 1}
                  disabled={@page == 1}
                  class="btn btn-ghost btn-xs btn-square"
                >
                  <.icon name="hero-chevron-left" class="w-4 h-4" />
                </button>

                <%= for p <- page_range(@page, @total_pages) do %>
                  <button
                    phx-click="change_page"
                    phx-value-page={p}
                    class={[
                      "btn btn-xs min-w-8",
                      if(p == @page, do: "btn-primary", else: "btn-ghost")
                    ]}
                  >
                    {p}
                  </button>
                <% end %>

                <button
                  phx-click="change_page"
                  phx-value-page={@page + 1}
                  disabled={@page == @total_pages}
                  class="btn btn-ghost btn-xs btn-square"
                >
                  <.icon name="hero-chevron-right" class="w-4 h-4" />
                </button>
              </div>

              <div class="text-sm text-base-content/60">
                {(@page - 1) * @page_size + 1}-{min(@page * @page_size, @total_entries)} of {@total_entries}
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </main>
  
<!-- Add Entry Modal -->
  <%= if @show_add_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center animate-in fade-in duration-150">
      <!-- Backdrop -->
      <div
        class="absolute inset-0 bg-black/60 backdrop-blur-sm"
        phx-click="close_add_modal"
      >
      </div>
      
<!-- Modal -->
      <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md mx-4 animate-in zoom-in-95 duration-200">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-5 border-b border-base-200">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-primary/10">
              <.icon name="hero-plus" class="w-5 h-5 text-primary" />
            </div>
            <h3 class="text-lg font-semibold">Add New Entry</h3>
          </div>
          <button
            phx-click="close_add_modal"
            class="btn btn-ghost btn-sm btn-circle hover:bg-base-200"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>
        
<!-- Modal Body -->
        <form phx-submit="add_entry" class="p-5 space-y-5">
          <div>
            <label class="label pb-1">
              <span class="label-text font-medium text-base-content/80">Name</span>
            </label>
            <input
              type="text"
              name="name"
              value={@new_entry_name}
              placeholder="e.g., San Francisco"
              class="input input-bordered w-full focus:input-primary transition-colors"
              autofocus
              required
            />
            <p class="text-xs text-base-content/50 mt-1.5">Enter a unique name for this entity</p>
          </div>

          <div>
            <label class="label pb-1">
              <span class="label-text font-medium text-base-content/80">Entity Type</span>
            </label>
            <select
              name="type"
              class="select select-bordered w-full focus:select-primary transition-colors"
            >
              <%= for type <- @entity_types do %>
                <option value={type} selected={@new_entry_type == type}>
                  {String.capitalize(type)}
                </option>
              <% end %>
            </select>
          </div>
          
<!-- Modal Footer -->
          <div class="flex gap-3 pt-3">
            <button
              type="button"
              phx-click="close_add_modal"
              class="btn btn-ghost flex-1 hover:bg-base-200"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary flex-1 shadow-sm hover:shadow-md transition-shadow"
            >
              <.icon name="hero-plus" class="w-4 h-4" /> Add Entry
            </button>
          </div>
        </form>
      </div>
    </div>
  <% end %>
</div>
